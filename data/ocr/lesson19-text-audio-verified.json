    "basicSentences": [
      {
        "id": "l19-basic-s001",
        "order": 1,
        "text": "部屋の かぎを 忘れないで ください。",
        "translationZh": "请不要忘记房间钥匙。",
        "confidence": "high",
        "rawText": "1. 部屋の かぎを 忘れないで ください。",
        "audioSegment": {
