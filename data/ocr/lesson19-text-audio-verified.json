        "label": "B",
        "lines": [
          {
            "id": "l19-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "李さん、いっしょに 食事に 行きませんか。",
            "translationZh": "小李，一起去吃饭吗？",
            "confidence": "high",
            "rawText": "甲：李さん、いっしょに 食事に 行きませんか。",
            "audioSegment": {
              "id": "l19-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.66,
              "duration": 3.66,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:12.141Z",
              "sourceAudioSha256": "7421fb66b2fbcac36e68fc0727cb03130255b4657075953b084e8e479c50a710"
            }
          },
          {
            "id": "l19-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "すみません。今日は 早く 帰って、レポートを 書かなければ なりません。",
            "translationZh": "不好意思。今天必须早点回去写报告。",
            "confidence": "high",
            "rawText": "乙：すみません。今日は 早く 帰って、レポートを 書かなければ なりません。",
            "audioSegment": {
              "id": "l19-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-basic-dialogue-002-line-002.mp3",
