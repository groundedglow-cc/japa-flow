  "applicationText": {
    "title": "スキー",
    "blocks": [
      {
        "id": "l19-app-block-001",
        "type": "scene",
        "text": "在滑雪场，小李显得十分拘谨。",
        "translationZh": "在滑雪场，小李显得十分拘谨。",
        "confidence": "high",
        "rawText": "在滑雪场，小李显得十分拘谨。"
      },
      {
        "id": "l19-app-block-002",
        "type": "dialogue",
        "lines": [
          {
            "id": "l19-app-block-002-line-001",
            "speaker": "李",
            "text": "小野さん、初めてですから、ちょっと 怖いです。",
            "translationZh": "小野，我是第一次滑雪，有点害怕。",
            "confidence": "high",
            "rawText": "李：小野さん、初めてですから、ちょっと 怖いです。",
            "audioSegment": {
              "id": "l19-app-block-002-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-002-line-001.mp3",
              "start": 0,
              "end": 10.14,
              "duration": 10.14,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          },
          {
            "id": "l19-app-block-002-line-002",
            "speaker": "小野",
            "text": "心配しなくても いいですよ。ここは 初心者コースですから。",
            "translationZh": "不用担心。这里是初学者滑道。",
            "confidence": "high",
            "rawText": "小野：心配しなくても いいですよ。ここは 初心者コースですから。",
            "audioSegment": {
              "id": "l19-app-block-002-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-002-line-002.mp3",
              "start": 0,
              "end": 4.1,
              "duration": 4.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          }
        ]
      },
      {
        "id": "l19-app-block-003",
        "type": "scene",
        "text": "小李在森、小野的后面担心吊胆地滑着。",
        "translationZh": "小李在森、小野的后面担心吊胆地滑着。",
        "confidence": "high",
        "rawText": "小李在森、小野的后面担心吊胆地滑着。"
      },
      {
        "id": "l19-app-block-004",
        "type": "dialogue",
        "lines": [
          {
            "id": "l19-app-block-004-line-001",
            "speaker": "李",
            "text": "森さん、小野さん、待って ください。先に 行かないで ください。",
            "translationZh": "森先生、小野，请等一等。请不要先走。",
            "confidence": "high",
            "rawText": "李：森さん、小野さん、待って ください。先に 行かないで ください。",
            "audioSegment": {
              "id": "l19-app-block-004-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-004-line-001.mp3",
              "start": 0,
              "end": 5.42,
              "duration": 5.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          },
          {
            "id": "l19-app-block-004-line-002",
            "speaker": "小野",
            "text": "急がなくても いいですよ。わたしたちも ゆっくり 滑りますから。",
            "translationZh": "不用着急。我们也慢慢滑。",
            "confidence": "high",
            "rawText": "小野：急がなくても いいですよ。わたしたちも ゆっくり 滑りますから。",
            "audioSegment": {
              "id": "l19-app-block-004-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-004-line-002.mp3",
              "start": 0,
              "end": 4.26,
              "duration": 4.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          }
        ]
      },
      {
        "id": "l19-app-block-005",
        "type": "scene",
        "text": "滑了一会儿后，在休息处。",
        "translationZh": "滑了一会儿后，在休息处。",
        "confidence": "high",
        "rawText": "滑了一会儿后，在休息处。"
      },
      {
        "id": "l19-app-block-006",
        "type": "dialogue",
        "lines": [
          {
            "id": "l19-app-block-006-line-001",
            "speaker": "森",
            "text": "李さん、スキーは どうですか。",
            "translationZh": "小李，滑雪怎么样？",
            "confidence": "high",
            "rawText": "森：李さん、スキーは どうですか。",
            "audioSegment": {
              "id": "l19-app-block-006-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-006-line-001.mp3",
              "start": 0,
              "end": 1.1,
              "duration": 1.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          },
          {
            "id": "l19-app-block-006-line-002",
            "speaker": "李",
            "text": "何度も 転びましたが、とても おもしろいです。",
            "translationZh": "摔倒了好几次，不过很有意思。",
            "confidence": "high",
            "rawText": "李：何度も 転びましたが、とても おもしろいです。",
            "audioSegment": {
              "id": "l19-app-block-006-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-006-line-002.mp3",
              "start": 0,
              "end": 3.22,
              "duration": 3.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          },
          {
            "id": "l19-app-block-006-line-003",
            "speaker": "森",
            "text": "そうですか。だいぶ 上手に なりましたよ。",
            "translationZh": "是吗？你已经熟练多了。",
            "confidence": "high",
            "rawText": "森：そうですか。だいぶ 上手に なりましたよ。",
            "audioSegment": {
              "id": "l19-app-block-006-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-006-line-003.mp3",
              "start": 0,
              "end": 2.74,
              "duration": 2.74,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          },
          {
            "id": "l19-app-block-006-line-004",
            "speaker": "李",
            "text": "本当ですか。でも、もっと 上手に なりたいです。",
            "translationZh": "真的吗？不过我还想更熟练些。",
            "confidence": "high",
            "rawText": "李：本当ですか。でも、もっと 上手に なりたいです。",
            "audioSegment": {
              "id": "l19-app-block-006-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-006-line-004.mp3",
              "start": 0,
              "end": 4.06,
              "duration": 4.06,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          },
          {
            "id": "l19-app-block-006-line-005",
            "speaker": "小野",
            "text": "じゃあ、もっと 練習しなければ なりませんね。もう 一度 滑りますか。",
            "translationZh": "那就必须多练习。再滑一次吗？",
            "confidence": "high",
            "rawText": "小野：じゃあ、もっと 練習しなければ なりませんね。もう 一度 滑りますか。",
            "audioSegment": {
              "id": "l19-app-block-006-line-005",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-app-block-006-line-005.mp3",
              "start": 0,
              "end": 4.62,
              "duration": 4.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:43:52.614Z",
              "sourceAudioSha256": "8c251d442294180e6a1ae5f401958830a3262c49f4a0a137e5c661e377c2591b"
            }
          },
          {
            "id": "l19-app-block-006-line-006",
            "speaker": "李",
            "text": "はい。今度は 先に 滑っても いいですか。",
            "translationZh": "好。这次我可以先滑吗？",
            "confidence": "high",
            "rawText": "李：はい。今度は 先に 滑っても いいですか。",
            "audioSegment": {
