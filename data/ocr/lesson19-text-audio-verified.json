        }
      },
      {
        "id": "l19-basic-s003",
        "order": 3,
        "text": "明日は 残業しなくても いいですよ。",
        "translationZh": "明天不加班也可以。",
        "confidence": "high",
        "rawText": "3. 明日は 残業しなくても いいですよ。",
        "audioSegment": {
