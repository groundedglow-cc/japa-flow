              "sourceAudioSha256": "7421fb66b2fbcac36e68fc0727cb03130255b4657075953b084e8e479c50a710"
            }
          },
          {
            "id": "l19-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "はい、いいですよ。",
            "translationZh": "是的，可以了。",
            "confidence": "high",
