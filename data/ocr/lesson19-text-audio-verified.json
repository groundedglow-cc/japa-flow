              "sourceAudioSha256": "7421fb66b2fbcac36e68fc0727cb03130255b4657075953b084e8e479c50a710"
            }
          }
        ]
      },
      {
        "id": "l19-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l19-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "先生、もう 薬を 飲まなくても いいですか。",
            "translationZh": "医生，已经可以不吃药了吗？",
            "confidence": "high",
            "rawText": "甲：先生、もう 薬を 飲まなくても いいですか。",
            "audioSegment": {
              "id": "l19-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson19/l19-basic-dialogue-003-line-001.mp3",
