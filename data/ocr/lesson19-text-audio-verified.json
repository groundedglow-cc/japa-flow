        }
      },
      {
        "id": "l19-basic-s002",
        "order": 2,
        "text": "李さんは 今日 早く 帰らなければ なりません。",
        "translationZh": "小李今天必须早点回去。",
        "confidence": "high",
        "rawText": "2. 李さんは 今日 早く 帰らなければ なりません。",
        "audioSegment": {
