              "sourceAudioSha256": "d1c470976a922df347118f744efd6b88322448001c75334bcd239e6b73c379ef"
            }
          }
        ]
      },
      {
        "id": "l30-app-block-006",
        "type": "scene",
        "text": "在小马驾驶的车中",
        "translationZh": "在小马驾驶的车中。",
        "confidence": "high",
        "rawText": "（在小马驾驶的车中）"
      },
      {
        "id": "l30-app-block-007",
        "type": "dialogue",
        "lines": [
          {
            "id": "l30-app-block-007-line-001",
            "speaker": "李",
            "text": "近くに北京植物園があるので、帰りに寄ろうと思うんです。",
            "translationZh": "附近有北京植物园，我想回去时顺便去看看。",
            "confidence": "high",
            "rawText": "李：近くに北京植物園があるので、帰りに寄ろうと思うんです。",
            "audioSegment": {
              "id": "l30-app-block-007-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson30/l30-app-block-007-line-001.mp3",
              "start": 0,
              "end": 4.42,
              "duration": 4.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
