        "label": "A",
        "lines": [
          {
            "id": "l37-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "陳さんの携帯電話の番号が分からないんですが…。",
            "translationZh": "我不知道陈先生的手机号码……。",
            "confidence": "high",
            "rawText": "甲：陳さんの携帯電話の番号が分からないんですが…。",
            "audioSegment": {
              "id": "l37-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-dialogue-001-line-001.mp3",
