            }
          }
        ]
      },
      {
        "id": "l37-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l37-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "最近、ちょっと太りました。",
            "translationZh": "最近有点发胖了。",
            "confidence": "high",
            "rawText": "甲：最近、ちょっと太りました。",
            "audioSegment": {
              "id": "l37-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-dialogue-003-line-001.mp3",
