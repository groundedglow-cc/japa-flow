  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l37-basic-s001",
        "order": 1,
        "text": "優勝すれば、オリンピックに出場することができます。",
        "translationZh": "如果获得冠军，就能够参加奥运会。",
        "confidence": "high",
        "rawText": "1. 優勝すれば、オリンピックに出場することができます。",
        "audioSegment": {
          "id": "l37-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-s001.mp3",
          "start": 0,
          "end": 4.38,
          "duration": 4.38,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:19:01.708Z",
          "sourceAudioSha256": "65db4c30a21c097aa2cc2c6698b2170a43a00b938e6ae188679403a8ca5db5d5"
        }
      },
      {
        "id": "l37-basic-s002",
        "order": 2,
        "text": "天安門へ行くなら、地下鉄が便利ですよ。",
        "translationZh": "如果去天安门，坐地铁很方便。",
        "confidence": "high",
        "rawText": "2. 天安門へ行くなら、地下鉄が便利ですよ。",
        "audioSegment": {
          "id": "l37-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-s002.mp3",
          "start": 0,
          "end": 3.58,
          "duration": 3.58,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:19:01.708Z",
          "sourceAudioSha256": "65db4c30a21c097aa2cc2c6698b2170a43a00b938e6ae188679403a8ca5db5d5"
        }
      },
      {
        "id": "l37-basic-s003",
        "order": 3,
        "text": "映画でも見に行きませんか。",
        "translationZh": "一起去看场电影怎么样？",
        "confidence": "high",
        "rawText": "3. 映画でも見に行きませんか。",
        "audioSegment": {
          "id": "l37-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-s003.mp3",
          "start": 0,
          "end": 1.58,
          "duration": 1.58,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:19:01.708Z",
          "sourceAudioSha256": "65db4c30a21c097aa2cc2c6698b2170a43a00b938e6ae188679403a8ca5db5d5"
        }
      },
      {
        "id": "l37-basic-s004",
        "order": 4,
        "text": "パーティーで、戴さんとか楊さんとか、いろいろな人に会いました。",
        "translationZh": "在聚会上见到了戴先生、杨先生等各种各样的人。",
        "confidence": "high",
        "rawText": "4. パーティーで、戴さんとか楊さんとか、いろいろな人に会いました。",
        "audioSegment": {
          "id": "l37-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-s004.mp3",
          "start": 0,
          "end": 6.82,
          "duration": 6.82,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:19:01.708Z",
          "sourceAudioSha256": "65db4c30a21c097aa2cc2c6698b2170a43a00b938e6ae188679403a8ca5db5d5"
        }
      }
    ],
    "dialogues": [
      {
