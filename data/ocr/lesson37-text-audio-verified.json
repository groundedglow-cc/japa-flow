              "sourceAudioSha256": "65db4c30a21c097aa2cc2c6698b2170a43a00b938e6ae188679403a8ca5db5d5"
            }
          }
        ]
      },
      {
        "id": "l37-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l37-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "葉子さん、昨日バーゲンに行ったの？",
