      {
        "id": "l37-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l37-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "李さん、プールに行きませんか。",
            "translationZh": "小李，一起去游泳池吗？",
            "confidence": "high",
            "rawText": "甲：李さん、プールに行きませんか。",
            "audioSegment": {
              "id": "l37-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 1.26,
              "duration": 1.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:19:01.708Z",
              "sourceAudioSha256": "65db4c30a21c097aa2cc2c6698b2170a43a00b938e6ae188679403a8ca5db5d5"
            }
          },
          {
            "id": "l37-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "今日はちょっと用事があるんです。明日なら暇ですが…。",
            "translationZh": "我今天有点事。明天的话倒是有空……。",
            "confidence": "high",
            "rawText": "乙：今日はちょっと用事があるんです。明日なら暇ですが…。",
            "audioSegment": {
              "id": "l37-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson37/l37-basic-dialogue-002-line-002.mp3",
