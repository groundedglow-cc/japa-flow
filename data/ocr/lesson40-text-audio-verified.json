          "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
        }
      }
    ],
    "dialogues": [
      {
        "id": "l40-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l40-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "もしもし、森さん、今どこですか。",
            "translationZh": "喂，森先生，您现在在哪里？",
            "confidence": "high",
            "rawText": "甲：もしもし、森さん、今どこですか。",
            "audioSegment": {
              "id": "l40-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-dialogue-001-line-001.mp3",
