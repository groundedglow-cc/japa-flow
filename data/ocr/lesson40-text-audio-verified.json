  "basicText": {
    "title": "これから友達と食事に行くところです",
    "basicSentences": [
      {
        "id": "l40-basic-s001",
        "order": 1,
        "text": "これから友達と食事に行くところです。",
        "translationZh": "我正要和朋友去吃饭。",
        "confidence": "high",
        "rawText": "1. これから友達と食事に行くところです。",
        "audioSegment": {
          "id": "l40-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-s001.mp3",
          "start": 0,
          "end": 3.14,
          "duration": 3.14,
          "method": "approved-asr-alignment",
          "confidence": "approved",
