          "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
        }
      },
      {
        "id": "l40-basic-s002",
        "order": 2,
        "text": "森さんは会議の資料をそろえているところです。",
        "translationZh": "森先生正在备齐会议资料。",
        "confidence": "high",
        "rawText": "2. 森さんは会議の資料をそろえているところです。",
        "audioSegment": {
          "id": "l40-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-s002.mp3",
          "start": 0,
          "end": 4.02,
          "duration": 4.02,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:23:32.257Z",
          "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
        }
      },
      {
        "id": "l40-basic-s003",
        "order": 3,
        "text": "馬さんは、今、空港に着いたところです。",
        "translationZh": "马先生刚刚到达机场。",
        "confidence": "high",
        "rawText": "3. 馬さんは、今、空港に着いたところです。",
        "audioSegment": {
          "id": "l40-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-s003.mp3",
          "start": 0,
          "end": 3.02,
          "duration": 3.02,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:23:32.257Z",
          "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
        }
      },
      {
        "id": "l40-basic-s004",
        "order": 4,
        "text": "このモノレールは去年開通したばかりです。",
        "translationZh": "这条单轨铁路是去年刚开通的。",
        "confidence": "high",
        "rawText": "4. このモノレールは去年開通したばかりです。",
        "audioSegment": {
          "id": "l40-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-s004.mp3",
          "start": 0,
          "end": 3.5,
