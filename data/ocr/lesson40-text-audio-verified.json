  "applicationText": {
    "title": "京劇",
    "blocks": [
      {
        "id": "l40-app-block-001",
        "type": "scene",
        "text": "小野和小李在剧场前等森",
        "translationZh": "小野和小李在剧场前等森。",
        "confidence": "high",
        "rawText": "（小野和小李在剧场前等森）"
      },
      {
        "id": "l40-app-block-002",
        "type": "dialogue",
        "lines": [
          {
            "id": "l40-app-block-002-line-001",
            "speaker": "森",
            "text": "すみません。お待たせして。",
            "translationZh": "对不起，让你们久等了。",
            "confidence": "high",
            "rawText": "森：すみません。お待たせして。",
            "audioSegment": {
              "id": "l40-app-block-002-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-002-line-001.mp3",
              "start": 0,
              "end": 1.62,
              "duration": 1.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          },
          {
            "id": "l40-app-block-002-line-002",
            "speaker": "小野",
            "text": "いいえ、わたしたちもちょっと前に着いたところです。",
            "translationZh": "没关系，我们也是刚到不久。",
            "confidence": "high",
            "rawText": "小野：いいえ、わたしたちもちょっと前に着いたところです。",
            "audioSegment": {
              "id": "l40-app-block-002-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-002-line-002.mp3",
              "start": 0,
              "end": 3.66,
              "duration": 3.66,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          },
          {
            "id": "l40-app-block-002-line-003",
            "speaker": "森",
            "text": "そうですか。よかった。チケットは？",
            "translationZh": "是吗？太好了。票呢？",
            "confidence": "high",
            "rawText": "森：そうですか。よかった。チケットは？",
            "audioSegment": {
              "id": "l40-app-block-002-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-002-line-003.mp3",
              "start": 0,
              "end": 3.18,
              "duration": 3.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          },
          {
            "id": "l40-app-block-002-line-004",
            "speaker": "李",
            "text": "これから買うところです。",
            "translationZh": "正要去买。",
            "confidence": "high",
            "rawText": "李：これから買うところです。",
            "audioSegment": {
              "id": "l40-app-block-002-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-002-line-004.mp3",
              "start": 0,
              "end": 1.74,
              "duration": 1.74,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          },
          {
            "id": "l40-app-block-002-line-005",
            "speaker": "森",
            "text": "じゃあ、ぼくが買ってきますよ。ここで待っていてください。",
            "translationZh": "那我去买吧。请你们在这里等着。",
            "confidence": "high",
            "rawText": "森：じゃあ、ぼくが買ってきますよ。ここで待っていてください。",
            "audioSegment": {
              "id": "l40-app-block-002-line-005",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-002-line-005.mp3",
              "start": 0,
              "end": 3.94,
              "duration": 3.94,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          }
        ]
      },
      {
        "id": "l40-app-block-003",
        "type": "scene",
        "text": "进入剧场就坐",
        "translationZh": "进入剧场就坐。",
        "confidence": "high",
        "rawText": "（进入剧场就坐）"
      },
      {
        "id": "l40-app-block-004",
        "type": "dialogue",
        "lines": [
          {
            "id": "l40-app-block-004-line-001",
            "speaker": "小野",
            "text": "この劇場、新しそうですね。",
            "translationZh": "这个剧场看起来很新啊。",
            "confidence": "high",
            "rawText": "小野：この劇場、新しそうですね。",
            "audioSegment": {
              "id": "l40-app-block-004-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-004-line-001.mp3",
              "start": 0,
              "end": 2.62,
              "duration": 2.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          },
          {
            "id": "l40-app-block-004-line-002",
            "speaker": "李",
            "text": "ええ、去年改築したばかりです。それまでは、清の時代にできた建物を修理しながら使い続けていました。",
            "translationZh": "是的，去年刚改建过。在那之前，一边修理清代建成的建筑，一边继续使用。",
            "confidence": "high",
            "rawText": "李：ええ、去年改築したばかりです。それまでは、清の時代にできた建物を修理しながら使い続けていました。",
            "audioSegment": {
              "id": "l40-app-block-004-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-004-line-002.mp3",
              "start": 0,
              "end": 8.46,
              "duration": 8.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          }
        ]
      },
      {
        "id": "l40-app-block-005",
        "type": "scene",
        "text": "演出结束后响起掌声。森急急忙忙跑向卫生间",
        "translationZh": "演出结束后响起掌声。森急急忙忙跑向卫生间。",
        "confidence": "high",
        "rawText": "（演出结束后响起掌声。森急急忙忙跑向卫生间）"
      },
      {
        "id": "l40-app-block-006",
        "type": "dialogue",
        "lines": [
          {
            "id": "l40-app-block-006-line-001",
            "speaker": "李",
            "text": "小野さん、いかがでしたか。",
            "translationZh": "小野女士，觉得怎么样？",
            "confidence": "high",
            "rawText": "李：小野さん、いかがでしたか。",
            "audioSegment": {
              "id": "l40-app-block-006-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-006-line-001.mp3",
              "start": 0,
              "end": 26.55,
              "duration": 26.55,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          },
          {
            "id": "l40-app-block-006-line-002",
            "speaker": "小野",
            "text": "すばらしかったです。見終わったばかりで、まだ耳の奥に音楽が残っています。",
            "translationZh": "太精彩了。刚看完，音乐还在耳畔回响。",
            "confidence": "high",
            "rawText": "小野：すばらしかったです。見終わったばかりで、まだ耳の奥に音楽が残っています。",
            "audioSegment": {
              "id": "l40-app-block-006-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-app-block-006-line-002.mp3",
              "start": 0,
              "end": 6.1,
              "duration": 6.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:21.804Z",
              "sourceAudioSha256": "bb8f79f619bc6e694092c34fb236f99f0b22ead5e8ba9ecb62009634bd0dd47c"
            }
          }
        ]
      },
      {
        "id": "l40-app-block-007",
        "type": "scene",
        "text": "森从卫生间回来，发现小野不见了",
        "translationZh": "森从卫生间回来，发现小野不见了。",
