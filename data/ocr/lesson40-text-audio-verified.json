              "end": 3.82,
              "duration": 3.82,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:23:32.257Z",
              "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
            }
          },
          {
            "id": "l40-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "これから家を出るところです。",
            "translationZh": "我正要出门。",
            "confidence": "high",
            "rawText": "乙：これから家を出るところです。",
            "audioSegment": {
              "id": "l40-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 1.66,
              "duration": 1.66,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:23:32.257Z",
              "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
            }
          }
        ]
      },
      {
        "id": "l40-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l40-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "森さん、上海行きの最終便は何時か分かりましたか。",
            "translationZh": "森先生，去上海的最晚航班是几点，您知道了吗？",
            "confidence": "high",
            "rawText": "甲：森さん、上海行きの最終便は何時か分かりましたか。",
            "audioSegment": {
              "id": "l40-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 4.98,
              "duration": 4.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:23:32.257Z",
              "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
            }
          },
          {
            "id": "l40-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "今調べているところです。少し待ってください。",
            "translationZh": "我正在查，请稍等一下。",
            "confidence": "high",
            "rawText": "乙：今調べているところです。少し待ってください。",
            "audioSegment": {
              "id": "l40-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 3.9,
              "duration": 3.9,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:23:32.257Z",
              "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
            }
          }
        ]
      },
      {
        "id": "l40-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l40-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "来月、清水さんが結婚するのを知っていますか。",
            "translationZh": "你知道清水先生下个月要结婚吗？",
            "confidence": "high",
            "rawText": "甲：来月、清水さんが結婚するのを知っていますか。",
            "audioSegment": {
              "id": "l40-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 3.1,
              "duration": 3.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:23:32.257Z",
              "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
            }
          },
          {
            "id": "l40-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "ええ、たった今聞いたところです。",
            "translationZh": "嗯，我刚刚听说。",
            "confidence": "high",
            "rawText": "乙：ええ、たった今聞いたところです。",
            "audioSegment": {
              "id": "l40-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson40/l40-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 2.1,
              "duration": 2.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:23:32.257Z",
              "sourceAudioSha256": "e252972c642471375b2b879943703b81d4773e8a8bac97377cafbb28c9e36310"
            }
          }
        ]
      },
      {
        "id": "l40-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l40-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "李さん、この本はもう読み終わりましたか。",
            "translationZh": "小李，这本书你已经读完了吗？",
            "confidence": "high",
