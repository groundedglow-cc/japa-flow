          "sourceAudioSha256": "4c87fede6cb3db0f089a410e45a569feb909c70252fe5015150e87f3672c7693"
        }
      },
      {
        "id": "l7-basic-s004",
        "order": 4,
        "text": "コーラと ケーキを ください。",
        "kana": "コーラと ケーキを ください。",
        "translationZh": "请给我可乐和蛋糕。",
