      },
      {
        "id": "l7-basic-s002",
        "order": 2,
        "text": "李さんは 図書館で 勉強します。",
        "kana": "りさんは としょかんで べんきょうします。",
        "translationZh": "小李在图书馆学习。",
        "confidence": "high",
        "rawText": "2. 李さんは 図書館で 勉強します。",
        "audioSegment": {
          "id": "l7-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-basic-s002.mp3",
