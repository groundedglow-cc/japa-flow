  "applicationText": {
    "title": "昼ご飯",
    "blocks": [
      {
        "id": "l7-app-block-001",
        "type": "narration",
        "text": "一天中午，小李和小野一起到外面去吃午饭。",
        "kana": null,
        "translationZh": "一天中午，小李和小野一起到外面去吃午饭。",
        "confidence": "high",
        "rawText": "一天中午，小李和小野一起到外面去吃午饭。"
      },
      {
        "id": "l7-app-block-002",
        "type": "scene",
        "text": "（路上，她们遇见手提便利店袋子的吉田科长）",
        "kana": null,
        "translationZh": "路上，她们遇见手提便利店袋子的吉田科长。",
        "confidence": "high",
        "rawText": "（路上，她们遇见手提便利店袋子的吉田科长）"
      },
      {
        "id": "l7-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l7-app-block-003-line-001",
            "speaker": "吉田",
            "text": "李さん、これから 昼ご飯ですか。",
            "kana": "りさん、これから ひるごはんですか。",
            "translationZh": "小李，现在去吃午饭吗？",
            "confidence": "high",
            "rawText": "吉田：李さん、これから 昼ご飯ですか。",
            "audioSegment": {
              "id": "l7-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-app-block-003-line-001.mp3",
              "start": 0,
              "end": 3.1,
              "duration": 3.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:29:11.201Z",
              "sourceAudioSha256": "cf22ec06bfb5019afe20cb987a56eb3c3be22a808257a38ead4f109d78728ec6"
            }
          },
          {
            "id": "l7-app-block-003-line-002",
            "speaker": "李",
            "text": "はい、小野さんと いっしょに 行きます。",
            "kana": "はい、おのさんと いっしょに いきます。",
            "translationZh": "是的，和小野女士一起去。",
            "confidence": "high",
            "rawText": "李：はい、小野さんと いっしょに 行きます。",
            "audioSegment": {
              "id": "l7-app-block-003-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-app-block-003-line-002.mp3",
              "start": 0,
              "end": 2.5,
              "duration": 2.5,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:29:11.201Z",
              "sourceAudioSha256": "cf22ec06bfb5019afe20cb987a56eb3c3be22a808257a38ead4f109d78728ec6"
            }
          },
          {
            "id": "l7-app-block-003-line-003",
            "speaker": "小野",
            "text": "課長は？",
            "kana": "かちょうは？",
            "translationZh": "科长呢？",
            "confidence": "high",
            "rawText": "小野：課長は？",
            "audioSegment": {
              "id": "l7-app-block-003-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-app-block-003-line-003.mp3",
              "start": 0,
              "end": 0.38,
              "duration": 0.38,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:29:11.201Z",
              "sourceAudioSha256": "cf22ec06bfb5019afe20cb987a56eb3c3be22a808257a38ead4f109d78728ec6"
            }
          },
          {
            "id": "l7-app-block-003-line-004",
            "speaker": "吉田",
            "text": "コンビニで お弁当と お茶を 買いました。",
            "kana": "コンビニで おべんとうと おちゃを かいました。",
            "translationZh": "我在便利店买了盒饭和茶。",
            "confidence": "high",
            "rawText": "吉田：コンビニで お弁当と お茶を 買いました。",
            "audioSegment": {
              "id": "l7-app-block-003-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-app-block-003-line-004.mp3",
              "start": 0,
              "end": 3.26,
              "duration": 3.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:29:11.201Z",
              "sourceAudioSha256": "cf22ec06bfb5019afe20cb987a56eb3c3be22a808257a38ead4f109d78728ec6"
            }
          },
          {
            "id": "l7-app-block-003-line-005",
            "speaker": "李",
            "text": "いつも コンビニですか。",
            "kana": "いつも コンビニですか。",
            "translationZh": "总是在便利店买吗？",
            "confidence": "high",
            "rawText": "李：いつも コンビニですか。",
            "audioSegment": {
              "id": "l7-app-block-003-line-005",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-app-block-003-line-005.mp3",
              "start": 0,
              "end": 1.58,
              "duration": 1.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:29:11.201Z",
              "sourceAudioSha256": "cf22ec06bfb5019afe20cb987a56eb3c3be22a808257a38ead4f109d78728ec6"
            }
          },
          {
            "id": "l7-app-block-003-line-006",
            "speaker": "吉田",
            "text": "いいえ。いつもは そば屋で そばか うどんを 食べます。",
            "kana": "いいえ。いつもは そばやで そばか うどんを たべます。",
            "translationZh": "不。平时在荞麦面馆吃荞麦面或乌冬面。",
            "confidence": "high",
            "rawText": "吉田：いいえ。いつもは そば屋で そばか うどんを 食べます。",
            "audioSegment": {
              "id": "l7-app-block-003-line-006",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-app-block-003-line-006.mp3",
              "start": 0,
              "end": 3.98,
              "duration": 3.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:29:11.201Z",
              "sourceAudioSha256": "cf22ec06bfb5019afe20cb987a56eb3c3be22a808257a38ead4f109d78728ec6"
            }
          },
          {
            "id": "l7-app-block-003-line-007",
            "speaker": "李",
            "text": "そうですか。",
            "kana": "そうですか。",
            "translationZh": "是吗。",
            "confidence": "high",
            "rawText": "李：そうですか。",
            "audioSegment": {
              "id": "l7-app-block-003-line-007",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson7/l7-app-block-003-line-007.mp3",
