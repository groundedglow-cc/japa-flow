              "sourceAudioSha256": "cf22ec06bfb5019afe20cb987a56eb3c3be22a808257a38ead4f109d78728ec6"
            }
          },
          {
            "id": "l7-app-block-003-line-009",
            "speaker": "李",
            "text": "そうですね。",
            "kana": "そうですね。",
            "translationZh": "好啊。",
            "confidence": "high",
            "rawText": "李：そうですね。",
            "audioSegment": {
              "id": "l7-app-block-003-line-009",
