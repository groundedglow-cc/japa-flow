          "sourceAudioSha256": "4c87fede6cb3db0f089a410e45a569feb909c70252fe5015150e87f3672c7693"
        }
      },
      {
        "id": "l7-basic-s003",
        "order": 3,
        "text": "わたしは 毎朝 パンか お粥を 食べます。",
        "kana": "わたしは まいあさ パンか おかゆを たべます。",
        "translationZh": "我每天早上吃面包或粥。",
        "confidence": "high",
        "rawText": "3. わたしは 毎朝 パンか お粥を 食べます。",
        "audioSegment": {
