        }
      },
      {
        "id": "l13-basic-s004",
        "order": 4,
        "text": "午後 郵便局へ 荷物を 出しに 行きます。",
        "kana": "ごご ゆうびんきょくへ にもつを だしに いきます。",
        "translationZh": "下午去邮局寄包裹。",
        "confidence": "high",
        "rawText": "4. 午後 郵便局へ 荷物を 出しに 行きます。",
