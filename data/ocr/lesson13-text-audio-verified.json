        }
      },
      {
        "id": "l13-basic-s003",
        "order": 3,
        "text": "李さんは 1週間に 2回 プールへ 行きます。",
        "kana": "りさんは いっしゅうかんに にかい プールへ いきます。",
        "translationZh": "小李每周去两次游泳池。",
        "confidence": "high",
        "rawText": "3. 李さんは 1週間に 2回 プールへ 行きます。",
        "audioSegment": {
