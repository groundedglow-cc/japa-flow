            }
          },
          {
            "id": "l13-app-block-003-line-002",
            "speaker": "小野",
            "text": "李さんも いっしょに どうですか。",
            "kana": "りさんも いっしょに どうですか。",
            "translationZh": "小李也一起去怎么样？",
            "confidence": "high",
            "rawText": "小野：李さんも いっしょに どうですか。",
            "audioSegment": {
              "id": "l13-app-block-003-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson13/l13-app-block-003-line-002.mp3",
