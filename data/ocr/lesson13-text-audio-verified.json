  "applicationText": {
    "title": "居酒屋",
    "blocks": [
      {
        "id": "l13-app-block-001",
        "type": "narration",
        "text": "下午6点，小李正准备收拾东西回家，小野邀请她一起去喝酒。",
        "kana": null,
        "translationZh": "下午6点，小李正准备收拾东西回家，小野邀请她一起去喝酒。",
