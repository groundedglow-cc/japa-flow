  "applicationText": {
    "title": "お酒と お茶",
    "blocks": [
      {
        "id": "l12-app-block-001",
        "type": "narration",
        "text": "小李等去箱根一家有名的日式饭馆采访。采访结束后，他们一边吃饭一边聊起喝酒的事儿来。",
        "kana": null,
        "translationZh": "小李等去箱根一家有名的日式饭馆采访。采访结束后，他们一边吃饭一边聊起喝酒的事儿来。",
        "confidence": "high",
        "rawText": "小李等去箱根一家有名的日式饭馆采访。采访结束后，他们一边吃饭一边聊起喝酒的事儿来。"
      },
      {
        "id": "l12-app-block-002",
        "type": "scene",
        "text": "（一边喝酒一边说）",
        "kana": null,
        "translationZh": "一边喝酒一边说。",
        "confidence": "high",
        "rawText": "（一边喝酒一边说）"
      },
      {
        "id": "l12-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l12-app-block-003-line-001",
            "speaker": "李",
            "text": "長島さんは よく お酒を 飲みますか。",
            "kana": "ながしまさんは よく おさけを のみますか。",
            "translationZh": "长岛先生经常喝酒吗？",
            "confidence": "high",
            "rawText": "李：長島さんは よく お酒を 飲みますか。",
            "audioSegment": {
              "id": "l12-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson12/l12-app-block-003-line-001.mp3",
              "start": 0,
              "end": 7.46,
              "duration": 7.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:34:57.331Z",
              "sourceAudioSha256": "052cd4a9f9eca3be642bdd267437bcd633f55c10baf2d3eb543d51b579215276"
            }
          },
          {
            "id": "l12-app-block-003-line-002",
            "speaker": "長島",
            "text": "ええ。お酒は 大好きですから、毎晩 飲みますよ。",
            "kana": "ええ。おさけは だいすきですから、まいばん のみますよ。",
            "translationZh": "是的。因为我很喜欢酒，所以每天晚上都喝。",
            "confidence": "high",
            "rawText": "長島：ええ。お酒は 大好きですから、毎晩 飲みますよ。",
            "audioSegment": {
              "id": "l12-app-block-003-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson12/l12-app-block-003-line-002.mp3",
              "start": 0,
              "end": 3.5,
              "duration": 3.5,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:34:57.331Z",
              "sourceAudioSha256": "052cd4a9f9eca3be642bdd267437bcd633f55c10baf2d3eb543d51b579215276"
            }
          },
          {
            "id": "l12-app-block-003-line-003",
            "speaker": "李",
            "text": "ビールと 日本酒と、どちらが 好きですか。",
            "kana": "ビールと にほんしゅと、どちらが すきですか。",
            "translationZh": "啤酒和日本酒，你喜欢哪个？",
            "confidence": "high",
            "rawText": "李：ビールと 日本酒と、どちらが 好きですか。",
            "audioSegment": {
              "id": "l12-app-block-003-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson12/l12-app-block-003-line-003.mp3",
              "start": 0,
              "end": 3.1,
              "duration": 3.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:34:57.331Z",
              "sourceAudioSha256": "052cd4a9f9eca3be642bdd267437bcd633f55c10baf2d3eb543d51b579215276"
            }
          },
          {
            "id": "l12-app-block-003-line-004",
            "speaker": "長島",
            "text": "どちらも 好きです。でも、焼酎が いちばん 好きです。",
            "kana": "どちらも すきです。でも、しょうちゅうが いちばん すきです。",
            "translationZh": "两个都喜欢。不过我最喜欢烧酒。",
            "confidence": "high",
            "rawText": "長島：どちらも 好きです。でも、焼酎が いちばん 好きです。",
            "audioSegment": {
              "id": "l12-app-block-003-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson12/l12-app-block-003-line-004.mp3",
              "start": 0,
              "end": 3.46,
              "duration": 3.46,
