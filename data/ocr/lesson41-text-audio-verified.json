    "dialogues": [
      {
        "id": "l41-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l41-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "太田君、どうしたんだ。元気がないね。",
            "translationZh": "太田，你怎么了？没精神啊。",
            "confidence": "high",
            "rawText": "甲：太田君、どうしたんだ。元気がないね。",
            "audioSegment": {
              "id": "l41-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson41/l41-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 3.26,
              "duration": 3.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:59.931Z",
              "sourceAudioSha256": "241ddc96714b0867e5104c22a1c7278e2bd3fcd19612627d2057d6492fef877d"
            }
          },
          {
            "id": "l41-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "ええ。部長にしかられたんです。",
            "translationZh": "嗯。被部长批评了。",
            "confidence": "high",
            "rawText": "乙：ええ。部長にしかられたんです。",
            "audioSegment": {
              "id": "l41-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson41/l41-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 2.34,
              "duration": 2.34,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:59.931Z",
              "sourceAudioSha256": "241ddc96714b0867e5104c22a1c7278e2bd3fcd19612627d2057d6492fef877d"
            }
          }
        ]
      },
      {
        "id": "l41-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l41-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "李さん、どうしたんですか。",
            "translationZh": "小李，你怎么了？",
            "confidence": "high",
            "rawText": "甲：李さん、どうしたんですか。",
            "audioSegment": {
              "id": "l41-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson41/l41-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.87,
              "duration": 3.87,
