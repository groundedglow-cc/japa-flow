            }
          },
          {
            "id": "l41-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "昨日犬に手をかまれたんです。",
            "translationZh": "昨天手被狗咬了。",
            "confidence": "high",
            "rawText": "乙：昨日犬に手をかまれたんです。",
            "audioSegment": {
              "id": "l41-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson41/l41-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 2.54,
              "duration": 2.54,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:59.931Z",
              "sourceAudioSha256": "241ddc96714b0867e5104c22a1c7278e2bd3fcd19612627d2057d6492fef877d"
            }
          }
        ]
      },
      {
        "id": "l41-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l41-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "週末にキャンプに行きました。",
            "translationZh": "周末去露营了。",
            "confidence": "high",
            "rawText": "甲：週末にキャンプに行きました。",
            "audioSegment": {
              "id": "l41-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson41/l41-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 2.46,
              "duration": 2.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:59.931Z",
              "sourceAudioSha256": "241ddc96714b0867e5104c22a1c7278e2bd3fcd19612627d2057d6492fef877d"
            }
          },
          {
            "id": "l41-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "へえ。楽しかったですか。",
            "translationZh": "哦。玩得开心吗？",
            "confidence": "high",
            "rawText": "乙：へえ。楽しかったですか。",
            "audioSegment": {
              "id": "l41-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson41/l41-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 1.38,
              "duration": 1.38,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:24:59.931Z",
              "sourceAudioSha256": "241ddc96714b0867e5104c22a1c7278e2bd3fcd19612627d2057d6492fef877d"
            }
          },
          {
            "id": "l41-basic-dialogue-003-line-003",
            "speaker": "甲",
            "text": "２日とも雨に降られて、大変でしたよ。",
            "translationZh": "两天都遇上了下雨，够受的。",
            "confidence": "high",
            "rawText": "甲：２日とも雨に降られて、大変でしたよ。",
            "audioSegment": {
              "id": "l41-basic-dialogue-003-line-003",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson41/l41-basic-dialogue-003-line-003.mp3",
