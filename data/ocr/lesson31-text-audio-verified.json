  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l31-basic-s001",
        "order": 1,
        "text": "このボタンを押すと、電源が入ります。",
        "translationZh": "按这个按钮，电源就会接通。",
        "confidence": "high",
        "rawText": "1. このボタンを押すと、電源が入ります。",
        "audioSegment": {
          "id": "l31-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-s001.mp3",
          "start": 0,
          "end": 2.82,
          "duration": 2.82,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:10:17.883Z",
          "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
        }
      },
      {
        "id": "l31-basic-s002",
        "order": 2,
        "text": "そのパソコンは、たまにフリーズすることがあります。",
        "translationZh": "那台电脑有时会死机。",
        "confidence": "high",
        "rawText": "2. そのパソコンは、たまにフリーズすることがあります。",
        "audioSegment": {
          "id": "l31-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-s002.mp3",
          "start": 0,
          "end": 3.94,
          "duration": 3.94,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:10:17.883Z",
          "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
        }
      },
      {
        "id": "l31-basic-s003",
        "order": 3,
        "text": "馬さんはとても上手にレポートをまとめました。",
        "translationZh": "小马把报告整理得非常好。",
        "confidence": "high",
        "rawText": "3. 馬さんはとても上手にレポートをまとめました。",
        "audioSegment": {
          "id": "l31-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-s003.mp3",
          "start": 0,
          "end": 3.58,
          "duration": 3.58,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:10:17.883Z",
          "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
        }
      },
      {
        "id": "l31-basic-s004",
        "order": 4,
        "text": "李さんは来るでしょうか。",
        "translationZh": "小李会来吗？",
        "confidence": "high",
        "rawText": "4. 李さんは来るでしょうか。",
        "audioSegment": {
          "id": "l31-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-s004.mp3",
          "start": 0,
          "end": 1.7,
          "duration": 1.7,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:10:17.883Z",
          "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
        }
      }
    ],
    "dialogues": [
      {
        "id": "l31-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l31-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "すみません。市役所へはどう行くんですか。",
            "translationZh": "请问，去市政府怎么走？",
            "confidence": "high",
            "rawText": "甲：すみません。市役所へはどう行くんですか。",
            "audioSegment": {
              "id": "l31-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 3.5,
              "duration": 3.5,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          },
          {
            "id": "l31-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "この道をまっすぐ行くと、デパートがあります。市役所はその隣ですよ。",
            "translationZh": "沿这条路一直走有一家百货商店。市政府就在它旁边。",
            "confidence": "high",
            "rawText": "乙：この道をまっすぐ行くと、デパートがあります。市役所はその隣ですよ。",
            "audioSegment": {
              "id": "l31-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 6.3,
              "duration": 6.3,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          },
          {
            "id": "l31-basic-dialogue-001-line-003",
            "speaker": "甲",
            "text": "ありがとうございます。",
            "translationZh": "谢谢。",
            "confidence": "high",
            "rawText": "甲：ありがとうございます。",
            "audioSegment": {
              "id": "l31-basic-dialogue-001-line-003",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-001-line-003.mp3",
              "start": 0,
              "end": 1.38,
              "duration": 1.38,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          }
        ]
      },
      {
        "id": "l31-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l31-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "朝ご飯は毎日きちんと食べますか。",
            "translationZh": "你每天都好好吃早饭吗？",
            "confidence": "high",
            "rawText": "甲：朝ご飯は毎日きちんと食べますか。",
            "audioSegment": {
              "id": "l31-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.3,
              "duration": 3.3,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          },
          {
            "id": "l31-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "ええ。でも、たまに食べないことがあります。",
            "translationZh": "是的。不过，有时也不吃。",
            "confidence": "high",
            "rawText": "乙：ええ。でも、たまに食べないことがあります。",
            "audioSegment": {
              "id": "l31-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 4.06,
              "duration": 4.06,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          }
        ]
      },
      {
        "id": "l31-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l31-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "あっ、雨ですよ。",
            "translationZh": "啊，下雨了。",
            "confidence": "high",
            "rawText": "甲：あっ、雨ですよ。",
            "audioSegment": {
              "id": "l31-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 1.66,
              "duration": 1.66,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          },
          {
            "id": "l31-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "本当ですね。早く家に帰りましょう。",
            "translationZh": "真的呢。我们快回家吧。",
            "confidence": "high",
            "rawText": "乙：本当ですね。早く家に帰りましょう。",
            "audioSegment": {
              "id": "l31-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 3.78,
              "duration": 3.78,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          }
        ]
      },
      {
        "id": "l31-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l31-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "すみません、馬さんはどちらでしょうか。",
            "translationZh": "请问，小马在哪里？",
            "confidence": "high",
            "rawText": "甲：すみません、馬さんはどちらでしょうか。",
            "audioSegment": {
              "id": "l31-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson31/l31-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 2.9,
              "duration": 2.9,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:10:17.883Z",
              "sourceAudioSha256": "5ca7aea2d6ffc6fea6f77a2a5b5ba9d1ebd13c7cfa2f0420e508c44d6ae08776"
            }
          },
          {
            "id": "l31-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "馬さんはさっき出かけましたよ。",
            "translationZh": "小马刚才出去了。",
            "confidence": "high",
