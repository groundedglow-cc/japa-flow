            }
          },
          {
            "id": "l42-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "それはいけませんね。お大事に。",
            "translationZh": "那可不行。请多保重。",
            "confidence": "high",
            "rawText": "乙：それはいけませんね。お大事に。",
            "audioSegment": {
              "id": "l42-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson42/l42-basic-dialogue-001-line-002.mp3",
