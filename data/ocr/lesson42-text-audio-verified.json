      {
        "id": "l42-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l42-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "すみません、このパソコン、電源を入れたのに動かないんですが・・・。",
            "translationZh": "不好意思，这台电脑明明已经通电了却还是不工作……",
            "confidence": "high",
            "rawText": "甲：すみません、このパソコン、電源を入れたのに動かないんですが・・・。",
            "audioSegment": {
              "id": "l42-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson42/l42-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 5.02,
              "duration": 5.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:26:40.221Z",
              "sourceAudioSha256": "dea4da14bad38f49c93766151e400485220b538d4ea29ecfef668cbc10acd3d6"
            }
          },
          {
            "id": "l42-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "ああ、そのパソコンは壊れているんです。",
            "translationZh": "啊，那台电脑坏了。",
            "confidence": "high",
            "rawText": "乙：ああ、そのパソコンは壊れているんです。",
            "audioSegment": {
              "id": "l42-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson42/l42-basic-dialogue-002-line-002.mp3",
