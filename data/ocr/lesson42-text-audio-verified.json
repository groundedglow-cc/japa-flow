  "applicationText": {
    "title": "企画案",
    "blocks": [
      {
        "id": "l42-app-block-001",
        "type": "narration",
        "text": "JC策划北京分公司，以森和小李为主，制定了CS公司委托的新商品宣传策划方案。在策划方案说明会之前，为了征求意见，森把策划方案送到了CS公司。",
        "kana": null,
        "translationZh": "JC策划北京分公司，以森和小李为主，制定了CS公司委托的新商品宣传策划方案。在策划方案说明会之前，为了征求意见，森把策划方案送到了CS公司。",
        "confidence": "high",
        "rawText": "JC策划北京分公司，以森和小李为主，制定了CS公司委托的新商品宣传策划方案。在策划方案说明会之前，为了征求意见，森把策划方案送到了CS公司。"
      },
      {
        "id": "l42-app-block-002",
        "type": "scene",
        "text": "加藤经理接到CS公司太田先生的电话后，向小李确认",
        "kana": null,
        "translationZh": "加藤经理接到CS公司太田先生的电话后，向小李确认。",
        "confidence": "high",
        "rawText": "（加藤经理接到CS公司太田先生的电话后，向小李确认）"
      },
      {
        "id": "l42-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l42-app-block-003-line-001",
            "speaker": "加藤",
            "text": "今、太田さんから電話があったんだけど、まだ企画案が届いていないそうだよ。",
            "kana": null,
            "translationZh": "刚才太田先生来电话了，说策划方案还没有收到。",
            "confidence": "high",
            "rawText": "加藤：今、太田さんから電話があったんだけど、まだ企画案が届いていないそうだよ。",
            "audioSegment": {
              "id": "l42-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson42/l42-app-block-003-line-001.mp3",
              "start": 0,
              "end": 4.22,
              "duration": 4.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:27:30.524Z",
              "sourceAudioSha256": "3cd1334b0d88a515088c81505ba14f9f1d781e7adfb02e948f9bf41712edeea7"
            }
          },
          {
            "id": "l42-app-block-003-line-002",
            "speaker": "李",
            "text": "変ですね。森さんがおととい送ったはずですが。",
            "kana": null,
            "translationZh": "真奇怪。森先生应该是前天寄出的。",
            "confidence": "high",
            "rawText": "李：変ですね。森さんがおととい送ったはずですが。",
            "audioSegment": {
              "id": "l42-app-block-003-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson42/l42-app-block-003-line-002.mp3",
              "start": 0,
              "end": 2.9,
              "duration": 2.9,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:27:30.524Z",
              "sourceAudioSha256": "3cd1334b0d88a515088c81505ba14f9f1d781e7adfb02e948f9bf41712edeea7"
            }
          }
        ]
      },
      {
        "id": "l42-app-block-004",
        "type": "scene",
        "text": "小李向森确认",
        "kana": null,
        "translationZh": "小李向森确认。",
        "confidence": "high",
        "rawText": "（小李向森确认）"
      },
      {
