              "sourceAudioSha256": "3cd1334b0d88a515088c81505ba14f9f1d781e7adfb02e948f9bf41712edeea7"
            }
          },
          {
            "id": "l42-app-block-005-line-003",
            "speaker": "森",
            "text": "いえ、自分で届けたんです。西長安街の方へ行く用事があったので。",
            "kana": null,
            "translationZh": "不是，是我亲自送去的。因为我正好要去西长安街那边办事。",
            "confidence": "high",
            "rawText": "森：いえ、自分で届けたんです。西長安街の方へ行く用事があったので。",
            "audioSegment": {
              "id": "l42-app-block-005-line-003",
              "trackId": "lesson_apps",
