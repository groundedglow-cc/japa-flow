            }
          },
          {
            "id": "l42-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "１時間ほど前に会社を出ましたから、もう家に着いているはずです。",
            "translationZh": "他大约一小时前离开公司了，所以应该已经到家了。",
            "confidence": "high",
            "rawText": "乙：１時間ほど前に会社を出ましたから、もう家に着いているはずです。",
            "audioSegment": {
              "id": "l42-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson42/l42-basic-dialogue-003-line-002.mp3",
