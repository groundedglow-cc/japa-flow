        "type": "dialogue",
        "lines": [
          {
            "id": "l42-app-block-005-line-001",
            "speaker": "森",
            "text": "ええ？　おかしいな。そんなはずはないですよ。",
            "kana": null,
            "translationZh": "咦？奇怪，不可能啊。",
            "confidence": "high",
            "rawText": "森：ええ？　おかしいな。そんなはずはないですよ。",
            "audioSegment": {
              "id": "l42-app-block-005-line-001",
