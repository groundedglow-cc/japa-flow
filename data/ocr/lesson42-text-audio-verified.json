            "id": "l42-app-block-005-line-002",
            "speaker": "李",
            "text": "そうですよね。おととい送ったんですものね。",
            "kana": null,
            "translationZh": "是啊，您前天就寄出了嘛。",
            "confidence": "high",
            "rawText": "李：そうですよね。おととい送ったんですものね。",
            "audioSegment": {
              "id": "l42-app-block-005-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson42/l42-app-block-005-line-002.mp3",
