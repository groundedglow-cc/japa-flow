              "sourceAudioSha256": "3cd1334b0d88a515088c81505ba14f9f1d781e7adfb02e948f9bf41712edeea7"
            }
          },
          {
            "id": "l42-app-block-005-line-004",
            "speaker": "李",
            "text": "じゃあ、太田さんに直接渡したんですか。",
            "kana": null,
