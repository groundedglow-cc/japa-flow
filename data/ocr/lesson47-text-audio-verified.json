        "type": "dialogue",
        "lines": [
          {
            "id": "l47-app-block-003-line-001",
            "speaker": "加藤",
            "text": "お食事はもうお済みになりましたか。",
            "translationZh": "您已经吃过饭了吗？",
            "confidence": "high",
            "rawText": "加藤：お食事はもうお済みになりましたか。",
            "audioSegment": {
              "id": "l47-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson47/l47-app-block-003-line-001.mp3",
