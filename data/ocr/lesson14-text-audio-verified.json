  "applicationText": {
    "title": "原稿",
    "blocks": [
      {
        "id": "l14-app-block-001",
        "type": "narration",
        "text": "一天晚上，小李回到公寓以后，用日语写好在箱根采访的稿子。第二天向吉田科长汇报。",
        "kana": null,
        "translationZh": "一天晚上，小李回到公寓以后，用日语写好在箱根采访的稿子。第二天向吉田科长汇报。",
        "confidence": "high",
        "rawText": "一天晚上，小李回到公寓以后，用日语写好在箱根采访的稿子。第二天向吉田科长汇报。"
      },
      {
        "id": "l14-app-block-002",
        "type": "scene",
        "text": "（在办公室）",
        "kana": null,
        "translationZh": "在办公室。",
        "confidence": "high",
        "rawText": "（在办公室）"
      },
      {
        "id": "l14-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l14-app-block-003-line-001",
            "speaker": "李",
            "text": "吉田課長、原稿が できました。",
            "kana": "よしだかちょう、げんこうが できました。",
            "translationZh": "吉田科长，稿子写好了。",
            "confidence": "high",
            "rawText": "李：吉田課長、原稿が できました。",
            "audioSegment": {
              "id": "l14-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-app-block-003-line-001.mp3",
              "start": 0,
              "end": 3.9,
              "duration": 3.9,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:37:35.851Z",
              "sourceAudioSha256": "23e101b162bae5ee678c864ffea7da51c8e82989c8a524271c268774b1f50d0f"
            }
          },
          {
            "id": "l14-app-block-003-line-002",
            "speaker": "吉田",
            "text": "箱根の 記事ですね。ちょっと 見せて ください。",
            "kana": "はこねの きじですね。ちょっと みせて ください。",
            "translationZh": "是箱根的报道吧。请给我看一下。",
            "confidence": "high",
            "rawText": "吉田：箱根の 記事ですね。ちょっと 見せて ください。",
            "audioSegment": {
              "id": "l14-app-block-003-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-app-block-003-line-002.mp3",
              "start": 0,
              "end": 3.34,
              "duration": 3.34,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:37:35.851Z",
              "sourceAudioSha256": "23e101b162bae5ee678c864ffea7da51c8e82989c8a524271c268774b1f50d0f"
            }
          }
        ]
      },
      {
        "id": "l14-app-block-004",
        "type": "scene",
        "text": "（快速浏览后）",
        "kana": null,
        "translationZh": "快速浏览后。",
        "confidence": "high",
        "rawText": "（快速浏览后）"
      },
      {
        "id": "l14-app-block-005",
        "type": "dialogue",
        "lines": [
          {
            "id": "l14-app-block-005-line-001",
            "speaker": "吉田",
            "text": "なかなか いいですね。いつ 書きましたか。",
            "kana": "なかなか いいですね。いつ かきましたか。",
            "translationZh": "相当不错啊。是什么时候写的？",
            "confidence": "high",
            "rawText": "吉田：なかなか いいですね。いつ 書きましたか。",
            "audioSegment": {
              "id": "l14-app-block-005-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-app-block-005-line-001.mp3",
              "start": 0,
              "end": 3.21,
              "duration": 3.21,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:37:35.851Z",
              "sourceAudioSha256": "23e101b162bae5ee678c864ffea7da51c8e82989c8a524271c268774b1f50d0f"
            }
          },
          {
            "id": "l14-app-block-005-line-002",
            "speaker": "李",
            "text": "昨日 会社で メモを 整理して、小野さんに 見せました。",
            "kana": "きのう かいしゃで メモを せいりして、おのさんに みせました。",
            "translationZh": "昨天在公司整理了笔记，给小野女士看了。",
            "confidence": "high",
            "rawText": "李：昨日 会社で メモを 整理して、小野さんに 見せました。",
            "audioSegment": {
              "id": "l14-app-block-005-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-app-block-005-line-002.mp3",
              "start": 0,
              "end": 3.78,
              "duration": 3.78,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:37:35.851Z",
              "sourceAudioSha256": "23e101b162bae5ee678c864ffea7da51c8e82989c8a524271c268774b1f50d0f"
            }
          },
          {
            "id": "l14-app-block-005-line-003",
            "speaker": "李",
            "text": "そして、アパートへ 帰ってから 書きました。",
            "kana": "そして、アパートへ かえってから かきました。",
            "translationZh": "然后回到公寓后写的。",
            "confidence": "high",
            "rawText": "そして、アパートへ 帰ってから 書きました。",
            "audioSegment": {
              "id": "l14-app-block-005-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-app-block-005-line-003.mp3",
              "start": 0,
              "end": 2.46,
              "duration": 2.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:37:35.851Z",
              "sourceAudioSha256": "23e101b162bae5ee678c864ffea7da51c8e82989c8a524271c268774b1f50d0f"
            }
          },
          {
            "id": "l14-app-block-005-line-004",
            "speaker": "吉田",
            "text": "そうですか。大変でしたね。写真も できましたか。",
            "kana": "そうですか。たいへんでしたね。しゃしんも できましたか。",
            "translationZh": "是吗。辛苦了。照片也弄好了吗？",
            "confidence": "high",
            "rawText": "吉田：そうですか。大変でしたね。写真も できましたか。",
            "audioSegment": {
              "id": "l14-app-block-005-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-app-block-005-line-004.mp3",
              "start": 0,
              "end": 4.66,
              "duration": 4.66,
              "method": "approved-asr-alignment",
