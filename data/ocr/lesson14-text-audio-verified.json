  "basicText": {
    "title": "昨日 デパートへ 行って、買い物しました",
    "basicSentences": [
      {
        "id": "l14-basic-s001",
        "order": 1,
        "text": "昨日 デパートへ 行って、買い物しました。",
        "kana": "きのう デパートへ いって、かいものしました。",
        "translationZh": "昨天去了百货商店，买了东西。",
        "confidence": "high",
        "rawText": "1. 昨日 デパートへ 行って、買い物しました。",
        "audioSegment": {
          "id": "l14-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-s001.mp3",
          "start": 0,
          "end": 3.82,
          "duration": 3.82,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:36:49.213Z",
          "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
        }
      },
      {
        "id": "l14-basic-s002",
        "order": 2,
        "text": "李さんは 毎晩 ラジオを 聞いてから 寝ます。",
        "kana": "りさんは まいばん ラジオを きいてから ねます。",
        "translationZh": "小李每天晚上听完收音机后睡觉。",
        "confidence": "high",
        "rawText": "2. 李さんは 毎晩 ラジオを 聞いてから 寝ます。",
        "audioSegment": {
          "id": "l14-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-s002.mp3",
          "start": 0,
          "end": 2.94,
          "duration": 2.94,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:36:49.213Z",
          "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
        }
      },
      {
        "id": "l14-basic-s003",
        "order": 3,
        "text": "ここに 住所と 名前を 書いて ください。",
        "kana": "ここに じゅうしょと なまえを かいて ください。",
        "translationZh": "请在这里写下住址和姓名。",
        "confidence": "high",
        "rawText": "3. ここに 住所と 名前を 書いて ください。",
        "audioSegment": {
          "id": "l14-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-s003.mp3",
          "start": 0,
          "end": 2.9,
          "duration": 2.9,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:36:49.213Z",
          "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
        }
      },
      {
        "id": "l14-basic-s004",
        "order": 4,
        "text": "李さんは 毎朝 7時に 家を 出ます。",
        "kana": "りさんは まいあさ しちじに いえを でます。",
        "translationZh": "小李每天早晨七点离开家。",
        "confidence": "high",
        "rawText": "4. 李さんは 毎朝 7時に 家を 出ます。",
        "audioSegment": {
          "id": "l14-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-s004.mp3",
          "start": 0,
          "end": 2.9,
          "duration": 2.9,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:36:49.213Z",
          "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
        }
      }
    ],
    "dialogues": [
      {
        "id": "l14-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l14-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "今日の 午後は 何を しますか。",
            "kana": "きょうの ごごは なにを しますか。",
            "translationZh": "今天下午做什么？",
            "confidence": "high",
            "rawText": "甲：今日の 午後は 何を しますか。",
            "audioSegment": {
              "id": "l14-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.18,
              "duration": 2.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          },
          {
            "id": "l14-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "図書館へ 行って、勉強を します。",
            "kana": "としょかんへ いって、べんきょうを します。",
            "translationZh": "去图书馆学习。",
            "confidence": "high",
            "rawText": "乙：図書館へ 行って、勉強を します。",
            "audioSegment": {
              "id": "l14-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 2.34,
              "duration": 2.34,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          },
          {
            "id": "l14-basic-dialogue-001-line-003",
            "speaker": "乙",
            "text": "それから 家へ 帰って、手紙を 書きます。",
            "kana": "それから いえへ かえって、てがみを かきます。",
            "translationZh": "然后回家写信。",
            "confidence": "high",
            "rawText": "それから 家へ 帰って、手紙を 書きます。",
            "audioSegment": {
              "id": "l14-basic-dialogue-001-line-003",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-001-line-003.mp3",
              "start": 0,
              "end": 3.22,
              "duration": 3.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          }
        ]
      },
      {
        "id": "l14-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l14-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "いつ 出かけますか。",
            "kana": "いつ でかけますか。",
            "translationZh": "什么时候出门？",
            "confidence": "high",
            "rawText": "甲：いつ 出かけますか。",
            "audioSegment": {
              "id": "l14-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 1.58,
              "duration": 1.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          },
          {
            "id": "l14-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "昼ご飯を 食べてから 出かけます。",
            "kana": "ひるごはんを たべてから でかけます。",
            "translationZh": "吃完午饭后出门。",
            "confidence": "high",
            "rawText": "乙：昼ご飯を 食べてから 出かけます。",
            "audioSegment": {
              "id": "l14-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 2.26,
              "duration": 2.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          }
        ]
      },
      {
        "id": "l14-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l14-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "すみません、この 荷物を 中国へ 送って ください。",
            "kana": "すみません、この にもつを ちゅうごくへ おくって ください。",
            "translationZh": "劳驾，请把这个包裹寄到中国。",
            "confidence": "high",
            "rawText": "甲：すみません、この 荷物を 中国へ 送って ください。",
            "audioSegment": {
              "id": "l14-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 3.66,
              "duration": 3.66,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          },
          {
            "id": "l14-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "船便ですか、航空便ですか。",
            "kana": "ふなびんですか、こうくうびんですか。",
            "translationZh": "海运还是航空邮件？",
            "confidence": "high",
            "rawText": "乙：船便ですか、航空便ですか。",
            "audioSegment": {
              "id": "l14-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 2.58,
              "duration": 2.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          },
          {
            "id": "l14-basic-dialogue-003-line-003",
            "speaker": "甲",
            "text": "船便で お願いします。",
            "kana": "ふなびんで おねがいします。",
            "translationZh": "请走海运。",
            "confidence": "high",
            "rawText": "甲：船便で お願いします。",
            "audioSegment": {
              "id": "l14-basic-dialogue-003-line-003",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-003-line-003.mp3",
              "start": 0,
              "end": 1.78,
              "duration": 1.78,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          }
        ]
      },
      {
        "id": "l14-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l14-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "この バスは 駅前を 通りますか。",
            "kana": "この バスは えきまえを とおりますか。",
            "translationZh": "这辆公交车经过车站前面吗？",
            "confidence": "high",
            "rawText": "甲：この バスは 駅前を 通りますか。",
            "audioSegment": {
              "id": "l14-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 2.7,
              "duration": 2.7,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:36:49.213Z",
              "sourceAudioSha256": "fbff5318bcc9b90d5df6e1c967049a04c182de68c18e3946514732b1402508e6"
            }
          },
          {
            "id": "l14-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "はい、通ります。",
            "kana": "はい、とおります。",
            "translationZh": "是的，经过。",
            "confidence": "high",
            "rawText": "乙：はい、通ります。",
            "audioSegment": {
              "id": "l14-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson14/l14-basic-dialogue-004-line-002.mp3",
