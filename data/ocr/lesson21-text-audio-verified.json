  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l21-basic-s001",
        "order": 1,
        "text": "わたしは すき焼きを 食べた ことが あります。",
        "translationZh": "我吃过寿喜烧。",
        "confidence": "high",
        "rawText": "1. わたしは すき焼きを 食べた ことが あります。",
        "audioSegment": {
          "id": "l21-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-s001.mp3",
          "start": 0,
          "end": 3.78,
          "duration": 3.78,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:45:36.419Z",
          "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
        }
      },
      {
        "id": "l21-basic-s002",
        "order": 2,
        "text": "李さんは 会社が 終わった 後で、飲みに 行きます。",
        "translationZh": "小李公司下班后去喝酒。",
        "confidence": "high",
        "rawText": "2. 李さんは 会社が 終わった 後で、飲みに 行きます。",
        "audioSegment": {
          "id": "l21-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-s002.mp3",
          "start": 0,
          "end": 3.54,
          "duration": 3.54,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:45:36.419Z",
          "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
        }
      },
      {
        "id": "l21-basic-s003",
        "order": 3,
        "text": "もっと 野菜を 食べた ほうが いいですよ。",
        "translationZh": "还是多吃点蔬菜好。",
        "confidence": "high",
        "rawText": "3. もっと 野菜を 食べた ほうが いいですよ。",
        "audioSegment": {
          "id": "l21-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-s003.mp3",
          "start": 0,
          "end": 2.58,
          "duration": 2.58,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:45:36.419Z",
          "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
        }
      },
      {
        "id": "l21-basic-s004",
        "order": 4,
        "text": "窓を 閉めましょうか。",
        "translationZh": "把窗户关上吧。",
        "confidence": "high",
        "rawText": "4. 窓を 閉めましょうか。",
        "audioSegment": {
          "id": "l21-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-s004.mp3",
          "start": 0,
          "end": 1.3,
          "duration": 1.3,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:45:36.419Z",
          "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
        }
      }
    ],
    "dialogues": [
      {
        "id": "l21-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l21-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "お寿司を 食べた ことが ありますか。",
            "translationZh": "吃过寿司吗？",
            "confidence": "high",
            "rawText": "甲：お寿司を 食べた ことが ありますか。",
            "audioSegment": {
              "id": "l21-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 3.02,
              "duration": 3.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:36.419Z",
              "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
            }
          },
          {
            "id": "l21-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "いいえ、一度も ありません。天ぷらは 食べた ことが あります。",
            "translationZh": "没有，一次也没有。天妇罗吃过。",
            "confidence": "high",
            "rawText": "乙：いいえ、一度も ありません。天ぷらは 食べた ことが あります。",
            "audioSegment": {
              "id": "l21-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 4.82,
              "duration": 4.82,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:36.419Z",
              "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
            }
          }
        ]
      },
      {
        "id": "l21-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l21-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "この 資料を 見ても いいですか。",
            "translationZh": "可以看这份资料吗？",
            "confidence": "high",
            "rawText": "甲：この 資料を 見ても いいですか。",
            "audioSegment": {
              "id": "l21-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 1.98,
              "duration": 1.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:36.419Z",
              "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
            }
          },
          {
            "id": "l21-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "はい。読んだ 後で、森さんに 渡して ください。",
            "translationZh": "可以。读完后请交给森先生。",
            "confidence": "high",
            "rawText": "乙：はい。読んだ 後で、森さんに 渡して ください。",
            "audioSegment": {
              "id": "l21-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 3.18,
              "duration": 3.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:36.419Z",
              "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
            }
          }
        ]
      },
      {
        "id": "l21-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l21-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "ホテルを 予約した ほうが いいですか。",
            "translationZh": "还是预约宾馆比较好吗？",
            "confidence": "high",
            "rawText": "甲：ホテルを 予約した ほうが いいですか。",
            "audioSegment": {
              "id": "l21-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 2.22,
              "duration": 2.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:36.419Z",
              "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
            }
          },
          {
            "id": "l21-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "そうですね。連休ですから、その ほうが いいですね。",
            "translationZh": "是啊。因为是连休，那样比较好。",
            "confidence": "high",
            "rawText": "乙：そうですね。連休ですから、その ほうが いいですね。",
            "audioSegment": {
              "id": "l21-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 3.18,
              "duration": 3.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:36.419Z",
              "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
            }
          }
        ]
      },
      {
        "id": "l21-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l21-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "何か 食べましょうか。",
            "translationZh": "吃点什么吧？",
            "confidence": "high",
            "rawText": "甲：何か 食べましょうか。",
            "audioSegment": {
              "id": "l21-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 1.54,
              "duration": 1.54,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:36.419Z",
              "sourceAudioSha256": "1e3d0633586d4a5744de3c78ec106a8fc12a2aae654699236b03e2612d96ec4e"
            }
          },
          {
            "id": "l21-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "いいえ。寝る 前に 食べない ほうが いいですよ。",
            "translationZh": "不，睡觉前最好不要吃。",
            "confidence": "high",
            "rawText": "乙：いいえ。寝る 前に 食べない ほうが いいですよ。",
            "audioSegment": {
              "id": "l21-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson21/l21-basic-dialogue-004-line-002.mp3",
