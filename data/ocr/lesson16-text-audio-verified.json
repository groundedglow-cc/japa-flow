  "applicationText": {
    "title": "展示場",
    "blocks": [
      {
        "id": "l16-app-block-001",
        "type": "scene",
        "text": "（在展览会场前）",
        "kana": null,
        "translationZh": "在展览会场前。",
        "confidence": "high",
        "rawText": "（在展览会场前）"
      },
      {
        "id": "l16-app-block-002",
        "type": "dialogue",
        "lines": [
          {
            "id": "l16-app-block-002-line-001",
            "speaker": "李",
            "text": "大きくて きれいな 建物ですね。",
            "kana": "おおきくて きれいな たてものですね。",
            "translationZh": "真是一座又大又漂亮的建筑啊。",
            "confidence": "high",
            "rawText": "李：大きくて きれいな 建物ですね。",
            "audioSegment": {
              "id": "l16-app-block-002-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-002-line-001.mp3",
              "start": 0,
              "end": 2.66,
              "duration": 2.66,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:40:23.423Z",
              "sourceAudioSha256": "12ea6ef8cfc33474d8b8bf77f93c19a4458ef0eb534fe460c6184627d144b69b"
            }
          },
          {
            "id": "l16-app-block-002-line-002",
            "speaker": "森",
            "text": "ええ。日本の 有名な 建築家の 設計で、最新の 展示場です。",
            "kana": "ええ。にほんの ゆうめいな けんちくかの せっけいで、さいしんの てんじじょうです。",
            "translationZh": "是的。这是日本著名建筑师设计的最新展览会场。",
            "confidence": "high",
            "rawText": "森：ええ。日本の 有名な 建築家の 設計で、最新の 展示場です。",
            "audioSegment": {
              "id": "l16-app-block-002-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-002-line-002.mp3",
              "start": 0,
              "end": 4.06,
              "duration": 4.06,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:40:23.423Z",
              "sourceAudioSha256": "12ea6ef8cfc33474d8b8bf77f93c19a4458ef0eb534fe460c6184627d144b69b"
            }
          },
          {
            "id": "l16-app-block-002-line-003",
            "speaker": "李",
            "text": "デザインが ユニークで、形が おもしろいですね。",
            "kana": "デザインが ユニークで、かたちが おもしろいですね。",
            "translationZh": "设计很独特，造型也很有意思。",
            "confidence": "high",
            "rawText": "李：デザインが ユニークで、形が おもしろいですね。",
            "audioSegment": {
              "id": "l16-app-block-002-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-002-line-003.mp3",
              "start": 0,
              "end": 2.42,
              "duration": 2.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:40:23.423Z",
              "sourceAudioSha256": "12ea6ef8cfc33474d8b8bf77f93c19a4458ef0eb534fe460c6184627d144b69b"
            }
          }
        ]
      },
      {
        "id": "l16-app-block-003",
        "type": "scene",
        "text": "（看见有很多保安人员）",
        "kana": null,
        "translationZh": "看见有很多保安人员。",
        "confidence": "high",
        "rawText": "（看见有很多保安人员）"
      },
      {
        "id": "l16-app-block-004",
        "type": "dialogue",
        "lines": [
          {
            "id": "l16-app-block-004-line-001",
            "speaker": "李",
            "text": "警備の 人が いろいろな 所に いますね。",
            "kana": "けいびの ひとが いろいろな ところに いますね。",
            "translationZh": "有保安人员在各种地方呢。",
            "confidence": "high",
            "rawText": "李：警備の 人が いろいろな 所に いますね。",
            "audioSegment": {
              "id": "l16-app-block-004-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-004-line-001.mp3",
              "start": 0,
              "end": 2.98,
              "duration": 2.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:40:23.423Z",
              "sourceAudioSha256": "12ea6ef8cfc33474d8b8bf77f93c19a4458ef0eb534fe460c6184627d144b69b"
            }
          },
          {
            "id": "l16-app-block-004-line-002",
            "speaker": "森",
            "text": "ここは 駅から 近くて、入場料も 安いです。",
            "kana": "ここは えきから ちかくて、にゅうじょうりょうも やすいです。",
            "translationZh": "这里离车站近，门票也便宜。",
            "confidence": "high",
            "rawText": "森：ここは 駅から 近くて、入場料も 安いです。",
            "audioSegment": {
              "id": "l16-app-block-004-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-004-line-002.mp3",
              "start": 0,
              "end": 4.06,
              "duration": 4.06,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:40:23.423Z",
              "sourceAudioSha256": "12ea6ef8cfc33474d8b8bf77f93c19a4458ef0eb534fe460c6184627d144b69b"
            }
          },
          {
            "id": "l16-app-block-004-line-003",
            "speaker": "森",
            "text": "たくさんの 人が 来ますから、警備が 厳重です。",
            "kana": "たくさんの ひとが きますから、けいびが げんじゅうです。",
            "translationZh": "因为来的人很多，所以警备很严。",
            "confidence": "high",
            "rawText": "たくさんの 人が 来ますから、警備が 厳重です。",
            "audioSegment": {
              "id": "l16-app-block-004-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-004-line-003.mp3",
              "start": 0,
              "end": 3.02,
              "duration": 3.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:40:23.423Z",
              "sourceAudioSha256": "12ea6ef8cfc33474d8b8bf77f93c19a4458ef0eb534fe460c6184627d144b69b"
            }
          },
          {
            "id": "l16-app-block-004-line-004",
            "speaker": "森",
            "text": "あっ、李さん、IDカードは ありますか。",
            "kana": "あっ、りさん、アイディーカードは ありますか。",
            "translationZh": "啊，小李，你有身份证件吗？",
            "confidence": "high",
            "rawText": "あっ、李さん、IDカードは ありますか。",
            "audioSegment": {
              "id": "l16-app-block-004-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-004-line-004.mp3",
              "start": 0,
              "end": 2.94,
              "duration": 2.94,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:40:23.423Z",
              "sourceAudioSha256": "12ea6ef8cfc33474d8b8bf77f93c19a4458ef0eb534fe460c6184627d144b69b"
            }
          },
          {
            "id": "l16-app-block-004-line-005",
            "speaker": "李",
            "text": "安心して ください。ちゃんと 持って います。",
            "kana": "あんしんして ください。ちゃんと もって います。",
            "translationZh": "请放心，我带着呢。",
            "confidence": "high",
            "rawText": "李：安心して ください。ちゃんと 持って います。",
            "audioSegment": {
              "id": "l16-app-block-004-line-005",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-app-block-004-line-005.mp3",
              "start": 0,
              "end": 1.94,
              "duration": 1.94,
              "method": "approved-asr-alignment",
