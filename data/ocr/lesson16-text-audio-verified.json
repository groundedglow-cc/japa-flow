    "dialogues": [
      {
        "id": "l16-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l16-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "森さんは どんな 人ですか。",
            "kana": "もりさんは どんな ひとですか。",
            "translationZh": "森先生是个什么样的人？",
            "confidence": "high",
            "rawText": "甲：森さんは どんな 人ですか。",
            "audioSegment": {
              "id": "l16-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.22,
              "duration": 2.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:39:28.079Z",
              "sourceAudioSha256": "0d402f07b7083bd778e623f683465394bee9cd322a6c9c8a9c4a14a4923f116e"
            }
          },
          {
            "id": "l16-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "背が 高くて 脚が 長くて、ハンサムな 人です。",
            "kana": "せが たかくて あしが ながくて、ハンサムな ひとです。",
            "translationZh": "他个子高、腿长，是个英俊的人。",
            "confidence": "high",
            "rawText": "乙：背が 高くて 脚が 長くて、ハンサムな 人です。",
            "audioSegment": {
              "id": "l16-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 3.54,
              "duration": 3.54,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:39:28.079Z",
              "sourceAudioSha256": "0d402f07b7083bd778e623f683465394bee9cd322a6c9c8a9c4a14a4923f116e"
            }
          }
        ]
      },
      {
        "id": "l16-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l16-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "日本は どうですか。",
            "kana": "にほんは どうですか。",
            "translationZh": "日本怎么样？",
            "confidence": "high",
            "rawText": "甲：日本は どうですか。",
            "audioSegment": {
              "id": "l16-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 1.62,
              "duration": 1.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:39:28.079Z",
              "sourceAudioSha256": "0d402f07b7083bd778e623f683465394bee9cd322a6c9c8a9c4a14a4923f116e"
            }
          },
          {
            "id": "l16-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "町が きれいで 安全ですが、物が 高いですね。",
            "kana": "まちが きれいで あんぜんですが、ものが たかいですね。",
            "translationZh": "城市很干净又安全，不过东西贵。",
            "confidence": "high",
            "rawText": "乙：町が きれいで 安全ですが、物が 高いですね。",
            "audioSegment": {
              "id": "l16-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 3.86,
              "duration": 3.86,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:39:28.079Z",
              "sourceAudioSha256": "0d402f07b7083bd778e623f683465394bee9cd322a6c9c8a9c4a14a4923f116e"
            }
          }
        ]
      },
      {
        "id": "l16-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l16-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "スミスさんは 会社員ですか。",
            "kana": "スミスさんは かいしゃいんですか。",
            "translationZh": "史密斯先生是公司职员吗？",
            "confidence": "high",
            "rawText": "甲：スミスさんは 会社員ですか。",
            "audioSegment": {
              "id": "l16-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 2.62,
              "duration": 2.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:39:28.079Z",
              "sourceAudioSha256": "0d402f07b7083bd778e623f683465394bee9cd322a6c9c8a9c4a14a4923f116e"
            }
          },
          {
            "id": "l16-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "ええ。旅行会社の 社員で、営業部の 部長です。",
            "kana": "ええ。りょこうがいしゃの しゃいんで、えいぎょうぶの ぶちょうです。",
            "translationZh": "是的。他是旅行社的职员，也是营业部部长。",
            "confidence": "high",
            "rawText": "乙：ええ。旅行会社の 社員で、営業部の 部長です。",
            "audioSegment": {
              "id": "l16-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 4.14,
              "duration": 4.14,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:39:28.079Z",
              "sourceAudioSha256": "0d402f07b7083bd778e623f683465394bee9cd322a6c9c8a9c4a14a4923f116e"
            }
          }
        ]
      },
      {
        "id": "l16-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l16-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "長島さんは どこに 住んで いますか。",
            "kana": "ながしまさんは どこに すんで いますか。",
            "translationZh": "长岛先生住在哪里？",
            "confidence": "high",
            "rawText": "甲：長島さんは どこに 住んで いますか。",
            "audioSegment": {
              "id": "l16-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 3.02,
              "duration": 3.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:39:28.079Z",
              "sourceAudioSha256": "0d402f07b7083bd778e623f683465394bee9cd322a6c9c8a9c4a14a4923f116e"
            }
          },
          {
            "id": "l16-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "家族と いっしょに 渋谷に 住んで います。",
            "kana": "かぞくと いっしょに しぶやに すんで います。",
            "translationZh": "和家人一起住在涩谷。",
            "confidence": "high",
            "rawText": "乙：家族と いっしょに 渋谷に 住んで います。",
            "audioSegment": {
              "id": "l16-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson16/l16-basic-dialogue-004-line-002.mp3",
              "start": 0,
              "end": 2.58,
              "duration": 2.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
