        }
      },
      {
        "id": "l33-basic-s003",
        "order": 3,
        "text": "森さんはボーナスを全部使ってしまいました。",
        "translationZh": "森先生把奖金全都花光了。",
        "confidence": "high",
        "rawText": "3. 森さんはボーナスを全部使ってしまいました。",
        "audioSegment": {
          "id": "l33-basic-s003",
          "trackId": "lesson_basic",
