        ]
      },
      {
        "id": "l33-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l33-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "おじいさんにもらった腕時計が壊れてしまいました。",
            "translationZh": "爷爷送给我的手表坏了。",
            "confidence": "high",
            "rawText": "甲：おじいさんにもらった腕時計が壊れてしまいました。",
            "audioSegment": {
              "id": "l33-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 3.22,
              "duration": 3.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:13:22.034Z",
              "sourceAudioSha256": "d77d4645a4f1bf9c3b0e0bb59a5d4b12ab02281d9bb40f7de6f4f29dc0e6076a"
            }
          },
          {
            "id": "l33-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "それは残念ですね。",
            "translationZh": "那真可惜。",
            "confidence": "high",
            "rawText": "乙：それは残念ですね。",
            "audioSegment": {
              "id": "l33-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-basic-dialogue-003-line-002.mp3",
