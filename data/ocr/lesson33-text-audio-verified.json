            }
          },
          {
            "id": "l33-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "いいえ、風で開いたんです。",
            "translationZh": "不，是被风吹开的。",
            "confidence": "high",
            "rawText": "乙：いいえ、風で開いたんです。",
            "audioSegment": {
              "id": "l33-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-basic-dialogue-001-line-002.mp3",
