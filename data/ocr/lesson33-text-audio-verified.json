            }
          },
          {
            "id": "l33-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "引き出しに入っていますよ。",
            "translationZh": "在抽屉里。",
            "confidence": "high",
            "rawText": "乙：引き出しに入っていますよ。",
            "audioSegment": {
              "id": "l33-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-basic-dialogue-002-line-002.mp3",
