  "applicationText": {
    "title": "再会",
    "blocks": [
      {
        "id": "l33-app-block-001",
        "type": "narration",
        "text": "五一期间放长假。小野今天从东京过来。森和小李到机场去迎接。森是从客户处直接赶过来的。因为气流的关系，小野提前到了30分钟左右。",
        "translationZh": "五一期间放长假。小野今天从东京过来。森和小李到机场去迎接。森是从客户处直接赶过来的。因为气流的关系，小野提前到了30分钟左右。",
        "confidence": "high",
        "rawText": "五一期间放长假。小野今天从东京过来。森和小李到机场去迎接。森是从客户处直接赶过来的。因为气流的关系，小野提前到了30分钟左右。"
      },
      {
        "id": "l33-app-block-002",
        "type": "scene",
        "text": "办理入境手续处排起了长队。小野一边排队等候，一边脚踢着。",
        "translationZh": "办理入境手续处排起了长队。小野一边排队等候，一边踢着脚。",
        "confidence": "high",
        "rawText": "（办理入境手续处排起了长队。小野一边排队等候，一边脚踢着）"
      },
      {
        "id": "l33-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l33-app-block-003-line-001",
            "speaker": "小野",
            "text": "ちょっと早く着いてしまったけど、森さんたちはもう来ているかしら。",
            "translationZh": "我稍微早到了些，不知森他们已经来了吗？",
            "confidence": "high",
            "rawText": "小野：ちょっと早く着いてしまったけど、森さんたちはもう来ているかしら。",
            "audioSegment": {
              "id": "l33-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-003-line-001.mp3",
              "start": 0,
              "end": 12.62,
              "duration": 12.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:05.443Z",
              "sourceAudioSha256": "ca1c6ed670b714f1c5271cfcc007dae086a28a8b7df8e6fbddf9ec989e7410a2"
            }
          }
        ]
      },
      {
        "id": "l33-app-block-004",
        "type": "scene",
        "text": "看着长队。",
        "translationZh": "看着长队。",
        "confidence": "high",
        "rawText": "（看着长队）"
      },
      {
        "id": "l33-app-block-005",
        "type": "dialogue",
        "lines": [
          {
            "id": "l33-app-block-005-line-001",
            "speaker": "小野",
            "text": "それにしても、大勢並んでいるわね。",
            "translationZh": "不过，排队的人真多啊。",
            "confidence": "high",
            "rawText": "小野：それにしても、大勢並んでいるわね。",
            "audioSegment": {
              "id": "l33-app-block-005-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-005-line-001.mp3",
              "start": 0,
              "end": 2.58,
              "duration": 2.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:05.443Z",
              "sourceAudioSha256": "ca1c6ed670b714f1c5271cfcc007dae086a28a8b7df8e6fbddf9ec989e7410a2"
            }
          }
        ]
      },
      {
        "id": "l33-app-block-006",
        "type": "scene",
        "text": "小野办完入境手续从海关出来，发现小李后挥手招呼。",
        "translationZh": "小野办完入境手续从海关出来，发现小李后挥手招呼。",
        "confidence": "high",
        "rawText": "（小野办完入境手续从海关出来，发现小李后挥手招呼）"
      },
      {
        "id": "l33-app-block-007",
        "type": "dialogue",
        "lines": [
          {
            "id": "l33-app-block-007-line-001",
            "speaker": "小野",
            "text": "李さん！",
            "translationZh": "小李！",
            "confidence": "high",
            "rawText": "小野：李さん！",
            "audioSegment": {
              "id": "l33-app-block-007-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-007-line-001.mp3",
              "start": 0,
              "end": 0.86,
              "duration": 0.86,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:05.443Z",
              "sourceAudioSha256": "ca1c6ed670b714f1c5271cfcc007dae086a28a8b7df8e6fbddf9ec989e7410a2"
            }
          },
          {
            "id": "l33-app-block-007-line-002",
            "speaker": "李",
            "text": "小野さん、お久しぶりです。",
            "translationZh": "小野女士，好久不见。",
            "confidence": "high",
            "rawText": "李：（小李跑了过来）小野さん、お久しぶりです。",
            "audioSegment": {
              "id": "l33-app-block-007-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-007-line-002.mp3",
              "start": 0,
              "end": 2.26,
              "duration": 2.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:05.443Z",
              "sourceAudioSha256": "ca1c6ed670b714f1c5271cfcc007dae086a28a8b7df8e6fbddf9ec989e7410a2"
            }
          },
          {
            "id": "l33-app-block-007-line-003",
            "speaker": "小野",
            "text": "本当にお久しぶり。お元気そうですね。",
            "translationZh": "真是好久不见。你看起来很精神。",
            "confidence": "high",
            "rawText": "小野：本当にお久しぶり。お元気そうですね。",
            "audioSegment": {
              "id": "l33-app-block-007-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-007-line-003.mp3",
              "start": 0,
              "end": 2.26,
              "duration": 2.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:05.443Z",
              "sourceAudioSha256": "ca1c6ed670b714f1c5271cfcc007dae086a28a8b7df8e6fbddf9ec989e7410a2"
            }
          },
          {
            "id": "l33-app-block-007-line-004",
            "speaker": "李",
            "text": "ええ、小野さんも。",
            "translationZh": "是的，小野女士您也是。",
            "confidence": "high",
            "rawText": "李：ええ、小野さんも。",
            "audioSegment": {
              "id": "l33-app-block-007-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-007-line-004.mp3",
              "start": 0,
              "end": 1.5,
              "duration": 1.5,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:05.443Z",
              "sourceAudioSha256": "ca1c6ed670b714f1c5271cfcc007dae086a28a8b7df8e6fbddf9ec989e7410a2"
            }
          }
        ]
      },
      {
        "id": "l33-app-block-008",
        "type": "scene",
        "text": "过了一会儿，森跑了过来。",
        "translationZh": "过了一会儿，森跑了过来。",
        "confidence": "high",
        "rawText": "（过了一会儿，森跑了过来）"
      },
      {
        "id": "l33-app-block-009",
        "type": "dialogue",
        "lines": [
          {
            "id": "l33-app-block-009-line-001",
            "speaker": "森",
            "text": "すみません、小野さん。遅刻してしまいました。",
            "translationZh": "对不起，小野女士。我迟到了。",
            "confidence": "high",
            "rawText": "森：すみません、小野さん。遅刻してしまいました。",
            "audioSegment": {
              "id": "l33-app-block-009-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-009-line-001.mp3",
              "start": 0,
              "end": 3.06,
              "duration": 3.06,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:05.443Z",
              "sourceAudioSha256": "ca1c6ed670b714f1c5271cfcc007dae086a28a8b7df8e6fbddf9ec989e7410a2"
            }
          },
          {
            "id": "l33-app-block-009-line-002",
            "speaker": "小野",
            "text": "相変わらずですね、森さん。でも、お元気そうで、何よりです。",
            "translationZh": "还是老样子啊，森先生。不过，您看起来很精神，比什么都好。",
            "confidence": "high",
            "rawText": "小野：相変わらずですね、森さん。でも、お元気そうで、何よりです。",
            "audioSegment": {
              "id": "l33-app-block-009-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-app-block-009-line-002.mp3",
