        "lines": [
          {
            "id": "l33-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "はさみはどこですか。",
            "translationZh": "剪刀在哪儿？",
            "confidence": "high",
            "rawText": "甲：はさみはどこですか。",
            "audioSegment": {
              "id": "l33-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-basic-dialogue-002-line-001.mp3",
