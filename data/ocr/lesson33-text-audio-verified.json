        }
      },
      {
        "id": "l33-basic-s004",
        "order": 4,
        "text": "このケーキはとてもおいしそうです。",
        "translationZh": "这个蛋糕看起来很好吃。",
        "confidence": "high",
        "rawText": "4. このケーキはとてもおいしそうです。",
