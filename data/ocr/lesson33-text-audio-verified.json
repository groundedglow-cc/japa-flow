        "lines": [
          {
            "id": "l33-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "あなたが窓を開けたんですか。",
            "translationZh": "是你打开窗户的吗？",
            "confidence": "high",
            "rawText": "甲：あなたが窓を開けたんですか。",
            "audioSegment": {
              "id": "l33-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson33/l33-basic-dialogue-001-line-001.mp3",
