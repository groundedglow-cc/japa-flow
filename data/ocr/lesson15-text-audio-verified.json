  "applicationText": {
    "title": "風邪",
    "blocks": [
      {
        "id": "l15-app-block-001",
        "type": "narration",
        "text": "一天早上，已经过了9点小李还没来上班。小野正在为她担心的时候，小李打来了电话。",
        "kana": null,
        "translationZh": "一天早上，已经过了9点小李还没来上班。小野正在为她担心的时候，小李打来了电话。",
        "confidence": "high",
        "rawText": "一天早上，已经过了9点小李还没来上班。小野正在为她担心的时候，小李打来了电话。"
      },
      {
        "id": "l15-app-block-002",
        "type": "scene",
        "text": "（电话转接到小野处）",
        "kana": null,
        "translationZh": "电话转接到小野处。",
        "confidence": "high",
        "rawText": "（电话转接到小野处）"
      },
      {
        "id": "l15-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l15-app-block-003-line-001",
            "speaker": "小野",
            "text": "もしもし、小野です。どうしました？",
            "kana": "もしもし、おのです。どうしました？",
            "translationZh": "喂，我是小野。怎么了？",
            "confidence": "high",
            "rawText": "小野：もしもし、小野です。どうしました？",
            "audioSegment": {
              "id": "l15-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson15/l15-app-block-003-line-001.mp3",
              "start": 0,
              "end": 2.18,
              "duration": 2.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:38:51.814Z",
              "sourceAudioSha256": "02277fc8846d6e3af3897c16a1155cad044f6db72ed21a994550b8b46154c14e"
            }
          },
          {
            "id": "l15-app-block-003-line-002",
            "speaker": "李",
            "text": "ちょっと 熱が あります。今日 会社を 休んでも いいですか。",
            "kana": "ちょっと ねつが あります。きょう かいしゃを やすんでも いいですか。",
            "translationZh": "我有点发烧。今天可以请假吗？",
            "confidence": "high",
            "rawText": "李：ちょっと 熱が あります。今日 会社を 休んでも いいですか。",
            "audioSegment": {
              "id": "l15-app-block-003-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson15/l15-app-block-003-line-002.mp3",
              "start": 0,
              "end": 4.86,
              "duration": 4.86,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:38:51.814Z",
              "sourceAudioSha256": "02277fc8846d6e3af3897c16a1155cad044f6db72ed21a994550b8b46154c14e"
            }
          },
          {
            "id": "l15-app-block-003-line-003",
            "speaker": "小野",
            "text": "ええ、もちろんです。あまり 無理を しては いけませんよ。",
            "kana": "ええ、もちろんです。あまり むりを しては いけませんよ。",
            "translationZh": "嗯，当然可以。不要太勉强自己。",
            "confidence": "high",
            "rawText": "小野：ええ、もちろんです。あまり 無理を しては いけませんよ。",
            "audioSegment": {
              "id": "l15-app-block-003-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson15/l15-app-block-003-line-003.mp3",
              "start": 0,
              "end": 3.66,
              "duration": 3.66,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:38:51.814Z",
              "sourceAudioSha256": "02277fc8846d6e3af3897c16a1155cad044f6db72ed21a994550b8b46154c14e"
            }
          },
          {
            "id": "l15-app-block-003-line-004",
            "speaker": "李",
            "text": "はい、分かりました。あのう、吉田課長は？",
            "kana": "はい、わかりました。あのう、よしだかちょうは？",
            "translationZh": "好的，我明白了。那个，吉田科长呢？",
            "confidence": "high",
            "rawText": "李：はい、分かりました。あのう、吉田課長は？",
            "audioSegment": {
              "id": "l15-app-block-003-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson15/l15-app-block-003-line-004.mp3",
              "start": 0,
              "end": 4.38,
              "duration": 4.38,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:38:51.814Z",
              "sourceAudioSha256": "02277fc8846d6e3af3897c16a1155cad044f6db72ed21a994550b8b46154c14e"
            }
          },
          {
            "id": "l15-app-block-003-line-005",
            "speaker": "小野",
            "text": "今 会議室で 打ち合わせを して います。後で 伝えます。",
            "kana": "いま かいぎしつで うちあわせを して います。あとで つたえます。",
            "translationZh": "他现在正在会议室商谈。之后我会转告他。",
            "confidence": "high",
            "rawText": "小野：今 会議室で 打ち合わせを して います。後で 伝えます。",
            "audioSegment": {
              "id": "l15-app-block-003-line-005",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson15/l15-app-block-003-line-005.mp3",
              "start": 0,
              "end": 4.22,
              "duration": 4.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:38:51.814Z",
              "sourceAudioSha256": "02277fc8846d6e3af3897c16a1155cad044f6db72ed21a994550b8b46154c14e"
            }
          },
          {
            "id": "l15-app-block-003-line-006",
            "speaker": "李",
            "text": "お願いします。",
            "kana": "おねがいします。",
            "translationZh": "拜托您了。",
            "confidence": "high",
            "rawText": "李：お願いします。",
            "audioSegment": {
              "id": "l15-app-block-003-line-006",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson15/l15-app-block-003-line-006.mp3",
