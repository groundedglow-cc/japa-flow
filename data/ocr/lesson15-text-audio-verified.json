              "sourceAudioSha256": "02277fc8846d6e3af3897c16a1155cad044f6db72ed21a994550b8b46154c14e"
            }
          },
          {
            "id": "l15-app-block-003-line-007",
            "speaker": "小野",
            "text": "もう 病院に 行きましたか。",
            "kana": "もう びょういんに いきましたか。",
            "translationZh": "已经去医院了吗？",
