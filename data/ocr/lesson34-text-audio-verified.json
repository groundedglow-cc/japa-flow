    "dialogues": [
      {
        "id": "l34-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l34-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "森さん、車をどこに止めましたか。",
            "translationZh": "森先生，您把车停在哪里了？",
            "confidence": "high",
            "rawText": "甲：森さん、車をどこに止めましたか。",
            "audioSegment": {
              "id": "l34-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.82,
              "duration": 2.82,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:38.357Z",
              "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
            }
          },
          {
            "id": "l34-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "公園の前に止めてあります。",
            "translationZh": "停在公园前面。",
            "confidence": "high",
            "rawText": "乙：公園の前に止めてあります。",
            "audioSegment": {
              "id": "l34-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 1.94,
              "duration": 1.94,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:38.357Z",
              "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
            }
          }
        ]
      },
      {
        "id": "l34-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l34-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "森さん、会議の資料はどうしますか。",
            "translationZh": "森先生，会议资料怎么办？",
            "confidence": "high",
            "rawText": "甲：森さん、会議の資料はどうしますか。",
            "audioSegment": {
              "id": "l34-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.58,
              "duration": 3.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:38.357Z",
              "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
            }
          },
          {
            "id": "l34-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "10部コピーしておいてください。",
            "translationZh": "请先复印10份。",
            "confidence": "high",
            "rawText": "乙：10部コピーしておいてください。",
            "audioSegment": {
              "id": "l34-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 1.98,
              "duration": 1.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:38.357Z",
              "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
            }
          }
        ]
      },
      {
        "id": "l34-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l34-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "カレーライスを作ってみました。食べてみてください。",
            "translationZh": "我试着做了咖喱饭。请尝尝看。",
            "confidence": "high",
            "rawText": "甲：カレーライスを作ってみました。食べてみてください。",
            "audioSegment": {
              "id": "l34-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 3.34,
              "duration": 3.34,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:38.357Z",
              "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
            }
          },
          {
            "id": "l34-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "ああ、おいしそうですね。いただきます。",
            "translationZh": "啊，看起来很好吃。那我开动了。",
            "confidence": "high",
            "rawText": "乙：ああ、おいしそうですね。いただきます。",
            "audioSegment": {
              "id": "l34-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 3.46,
              "duration": 3.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:38.357Z",
              "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
            }
          }
        ]
      },
      {
        "id": "l34-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l34-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "太田さん、タバコをやめたんですか。",
            "translationZh": "太田先生，您戒烟了吗？",
            "confidence": "high",
            "rawText": "甲：太田さん、タバコをやめたんですか。",
            "audioSegment": {
              "id": "l34-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 2.7,
              "duration": 2.7,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:14:38.357Z",
              "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
            }
          },
          {
            "id": "l34-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "ええ、健康のためにやめました。",
            "translationZh": "是的，为了健康戒掉了。",
            "confidence": "high",
            "rawText": "乙：ええ、健康のためにやめました。",
            "audioSegment": {
              "id": "l34-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-dialogue-004-line-002.mp3",
              "start": 0,
