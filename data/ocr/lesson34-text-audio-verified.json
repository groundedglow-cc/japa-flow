          "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
        }
      },
      {
        "id": "l34-basic-s004",
        "order": 4,
        "text": "日本へ留学するために、お金をためています。",
        "translationZh": "为了去日本留学，正在攒钱。",
        "confidence": "high",
        "rawText": "4. 日本へ留学するために、お金をためています。",
