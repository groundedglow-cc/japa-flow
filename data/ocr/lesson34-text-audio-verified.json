          "sourceAudioSha256": "825d6d30e9915e46fc569ab9c710a9269ce59af6ec7e6ddb59fd334a220c69fe"
        }
      },
      {
        "id": "l34-basic-s003",
        "order": 3,
        "text": "太田さんは中国語で手紙を書いてみました。",
        "translationZh": "太田先生试着用中文写了一封信。",
        "confidence": "high",
        "rawText": "3. 太田さんは中国語で手紙を書いてみました。",
        "audioSegment": {
          "id": "l34-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson34/l34-basic-s003.mp3",
