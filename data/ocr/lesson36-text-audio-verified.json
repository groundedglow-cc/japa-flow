        }
      },
      {
        "id": "l36-basic-s002",
        "order": 2,
        "text": "この写真はパスポートの申請に使います。",
        "translationZh": "这张照片用于申请护照。",
        "confidence": "high",
        "rawText": "2. この写真はパスポートの申請に使います。",
        "audioSegment": {
          "id": "l36-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-s002.mp3",
          "start": 0,
          "end": 3.94,
          "duration": 3.94,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:17:28.871Z",
          "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
        }
      },
      {
        "id": "l36-basic-s003",
        "order": 3,
        "text": "張さんは毎日お酒を飲んでばかりいます。",
        "translationZh": "小张每天净喝酒。",
        "confidence": "high",
        "rawText": "3. 張さんは毎日お酒を飲んでばかりいます。",
        "audioSegment": {
          "id": "l36-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-s003.mp3",
          "start": 0,
          "end": 3.02,
          "duration": 3.02,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:17:28.871Z",
          "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
        }
      },
      {
        "id": "l36-basic-s004",
        "order": 4,
        "text": "空港の入り口に警官が立っているのが見えます。",
        "translationZh": "能看见机场入口处站着一位警察。",
        "confidence": "high",
        "rawText": "4. 空港の入り口に警官が立っているのが見えます。",
        "audioSegment": {
          "id": "l36-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-s004.mp3",
