    "dialogues": [
      {
        "id": "l36-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l36-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "陳さん、明日のパーティーに行きますか。",
            "translationZh": "陈先生，您明天去聚会吗？",
            "confidence": "high",
            "rawText": "甲：陳さん、明日のパーティーに行きますか。",
            "audioSegment": {
              "id": "l36-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.74,
              "duration": 2.74,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:17:28.871Z",
              "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
            }
          },
          {
            "id": "l36-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "いいえ、明日は仕事で、行くことができません。",
            "translationZh": "不，明天要工作，去不了。",
            "confidence": "high",
            "rawText": "乙：いいえ、明日は仕事で、行くことができません。",
            "audioSegment": {
              "id": "l36-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 3.62,
              "duration": 3.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:17:28.871Z",
              "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
            }
          }
        ]
      },
      {
        "id": "l36-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l36-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "わあ、とても小さいカメラですね。",
            "translationZh": "哇，好小的相机啊。",
            "confidence": "high",
            "rawText": "甲：わあ、とても小さいカメラですね。",
            "audioSegment": {
              "id": "l36-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.18,
              "duration": 3.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:17:28.871Z",
              "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
            }
          },
          {
            "id": "l36-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "ええ。これは軽くて、持ち歩くのにとても便利なんですよ。",
            "translationZh": "是啊。它很轻，携带起来非常方便。",
            "confidence": "high",
            "rawText": "乙：ええ。これは軽くて、持ち歩くのにとても便利なんですよ。",
            "audioSegment": {
              "id": "l36-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 4.3,
              "duration": 4.3,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:17:28.871Z",
              "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
            }
          }
        ]
      },
      {
        "id": "l36-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l36-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "何で野菜ばかり食べているんですか。",
            "translationZh": "你为什么净吃蔬菜？",
            "confidence": "high",
            "rawText": "甲：何で野菜ばかり食べているんですか。",
            "audioSegment": {
              "id": "l36-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 2.42,
              "duration": 2.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:17:28.871Z",
              "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
            }
          },
          {
            "id": "l36-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "今、ダイエット中なんです。",
            "translationZh": "我现在正在减肥。",
            "confidence": "high",
            "rawText": "乙：今、ダイエット中なんです。",
            "audioSegment": {
              "id": "l36-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 2.54,
              "duration": 2.54,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:17:28.871Z",
              "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
            }
          }
        ]
      },
      {
        "id": "l36-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l36-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "李さんが呼んでいたのが聞こえましたか。",
            "translationZh": "听见小李在叫了吗？",
            "confidence": "high",
            "rawText": "甲：李さんが呼んでいたのが聞こえましたか。",
            "audioSegment": {
              "id": "l36-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 3.98,
              "duration": 3.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:17:28.871Z",
              "sourceAudioSha256": "6c83c50a490a063ec9b11bbd2a7a0508e2645874a934255d60d36b3d5b1e4723"
            }
          },
          {
            "id": "l36-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "いいえ、聞こえませんでした。",
            "translationZh": "没有，没听见。",
            "confidence": "high",
            "rawText": "乙：いいえ、聞こえませんでした。",
            "audioSegment": {
              "id": "l36-basic-dialogue-004-line-002",
