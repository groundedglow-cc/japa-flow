  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l36-basic-s001",
        "order": 1,
        "text": "遅くなって、すみません。",
        "translationZh": "对不起，我迟到了。",
        "confidence": "high",
        "rawText": "1. 遅くなって、すみません。",
        "audioSegment": {
          "id": "l36-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson36/l36-basic-s001.mp3",
