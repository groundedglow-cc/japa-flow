  "applicationText": {
    "title": "春節",
    "blocks": [
      {
        "id": "l20-app-block-001",
        "type": "scene",
        "text": "看着挂历。",
        "translationZh": "看着挂历。",
        "confidence": "high",
        "rawText": "看着挂历。"
      },
      {
        "id": "l20-app-block-002",
        "type": "dialogue",
        "lines": [
          {
            "id": "l20-app-block-002-line-001",
            "speaker": "小野",
            "text": "李さん、春節は 中国へ 帰りますか。",
            "translationZh": "小李，春节回中国吗？",
            "confidence": "high",
            "rawText": "小野：李さん、春節は 中国へ 帰りますか。",
            "audioSegment": {
              "id": "l20-app-block-002-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-002-line-001.mp3",
              "start": 0,
              "end": 2.14,
              "duration": 2.14,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-002-line-002",
            "speaker": "李",
            "text": "いいえ、今 日本の 仕事が 忙しいですから、帰りません。",
            "translationZh": "不，现在日本的工作很忙，所以不回去。",
            "confidence": "high",
            "rawText": "李：いいえ、今 日本の 仕事が 忙しいですから、帰りません。",
            "audioSegment": {
              "id": "l20-app-block-002-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-002-line-002.mp3",
              "start": 0,
              "end": 3.3,
              "duration": 3.3,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-002-line-003",
            "speaker": "森",
            "text": "じゃあ、いっしょに どこかへ 行きませんか。",
            "translationZh": "那一起去什么地方吧？",
            "confidence": "high",
            "rawText": "森：じゃあ、いっしょに どこかへ 行きませんか。",
            "audioSegment": {
              "id": "l20-app-block-002-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-002-line-003.mp3",
              "start": 0,
              "end": 2.9,
              "duration": 2.9,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-002-line-004",
            "speaker": "小野",
            "text": "横浜の 中華街へ 行きましょうよ。中国の 獅子舞を 見る ことが できますよ。",
            "translationZh": "去横滨中华街吧。可以看到中国的狮子舞。",
            "confidence": "high",
            "rawText": "小野：横浜の 中華街へ 行きましょうよ。中国の 獅子舞を 見る ことが できますよ。",
            "audioSegment": {
              "id": "l20-app-block-002-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-002-line-004.mp3",
              "start": 0,
              "end": 5.02,
              "duration": 5.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          }
        ]
      },
      {
        "id": "l20-app-block-003",
        "type": "scene",
        "text": "在中华街，饭后。",
        "translationZh": "在中华街，饭后。",
        "confidence": "high",
        "rawText": "在中华街，饭后。"
      },
      {
        "id": "l20-app-block-004",
        "type": "dialogue",
        "lines": [
          {
            "id": "l20-app-block-004-line-001",
            "speaker": "小野",
            "text": "料理は どうでしたか。",
            "translationZh": "菜怎么样？",
            "confidence": "high",
            "rawText": "小野：料理は どうでしたか。",
            "audioSegment": {
              "id": "l20-app-block-004-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-004-line-001.mp3",
              "start": 0,
              "end": 1.58,
              "duration": 1.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-004-line-002",
            "speaker": "李",
            "text": "とても おいしかったですよ。特に 餃子は。",
            "translationZh": "很好吃，特别是饺子。",
            "confidence": "high",
            "rawText": "李：とても おいしかったですよ。特に 餃子は。",
            "audioSegment": {
              "id": "l20-app-block-004-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-004-line-002.mp3",
              "start": 0,
              "end": 3.14,
              "duration": 3.14,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-004-line-003",
            "speaker": "森",
            "text": "李さんは 餃子を 作る ことが できますか。",
            "translationZh": "小李会包饺子吗？",
            "confidence": "high",
            "rawText": "森：李さんは 餃子を 作る ことが できますか。",
            "audioSegment": {
              "id": "l20-app-block-004-line-003",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-004-line-003.mp3",
              "start": 0,
              "end": 2.7,
              "duration": 2.7,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-004-line-004",
            "speaker": "李",
            "text": "ええ。北京では 春節の 前に、家族 みんなで 餃子を 作ります。",
            "translationZh": "会。在北京春节前全家人一起包饺子。",
            "confidence": "high",
            "rawText": "李：ええ。北京では 春節の 前に、家族 みんなで 餃子を 作ります。",
            "audioSegment": {
              "id": "l20-app-block-004-line-004",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-004-line-004.mp3",
              "start": 0,
              "end": 3.9,
              "duration": 3.9,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-004-line-005",
            "speaker": "小野",
            "text": "手作りの 餃子は 皮が おいしいですよね。",
            "translationZh": "手工饺子的皮很好吃吧。",
            "confidence": "high",
            "rawText": "小野：手作りの 餃子は 皮が おいしいですよね。",
            "audioSegment": {
              "id": "l20-app-block-004-line-005",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-004-line-005.mp3",
              "start": 0,
              "end": 2.42,
              "duration": 2.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-004-line-006",
            "speaker": "李",
            "text": "小野さんも 作る ことが できますか。",
            "translationZh": "小野也会做吗？",
            "confidence": "high",
            "rawText": "李：小野さんも 作る ことが できますか。",
            "audioSegment": {
              "id": "l20-app-block-004-line-006",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson20/l20-app-block-004-line-006.mp3",
              "start": 0,
              "end": 2.46,
              "duration": 2.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:45:03.611Z",
              "sourceAudioSha256": "11d2e0cc2548954dbf3362919ee729e1fae648dec261bd26c561398f004b9a38"
            }
          },
          {
            "id": "l20-app-block-004-line-007",
            "speaker": "小野",
            "text": "ええ、もちろん。わたしの 趣味は おいしい 物を 作る ことですから。",
