              "end": 3.06,
              "duration": 3.06,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:07:08.875Z",
              "sourceAudioSha256": "86e82b3e6e340b3205a1fa733f256e0f1db90defb65aeea4e7ada94ed48ca17f"
            }
          },
          {
            "id": "l29-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "今宿題しているんだ。お母さん先に入ってよ。",
            "kana": "いま しゅくだいしているんだ。おかあさん さきに はいってよ。",
            "translationZh": "我现在正在做作业。妈妈你先洗吧。",
            "confidence": "high",
            "rawText": "乙：今宿題しているんだ。お母さん先に入ってよ。",
            "audioSegment": {
              "id": "l29-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson29/l29-basic-dialogue-002-line-002.mp3",
