        "lines": [
          {
            "id": "l29-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "すみません、これは何と読みますか。",
            "kana": "すみません、これは なんと よみますか。",
            "translationZh": "请问，这个怎么读？",
            "confidence": "high",
            "rawText": "甲：すみません、これは何と読みますか。",
            "audioSegment": {
              "id": "l29-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson29/l29-basic-dialogue-003-line-001.mp3",
