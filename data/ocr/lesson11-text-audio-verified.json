  "applicationText": {
    "title": "お土産",
    "blocks": [
      {
        "id": "l11-app-block-001",
        "type": "narration",
        "text": "小李等人在箱根市内四处采访。由于交通便利，箱根有许多公司的别墅、疗养院。采访途中，小李进了一家商店买礼物。",
        "kana": null,
        "translationZh": "小李等人在箱根市内四处采访。由于交通便利，箱根有许多公司的别墅、疗养院。采访途中，小李进了一家商店买礼物。",
        "confidence": "high",
        "rawText": "小李等人在箱根市内四处采访。由于交通便利，箱根有许多公司的别墅、疗养院。采访途中，小李进了一家商店买礼物。"
      },
      {
        "id": "l11-app-block-002",
        "type": "scene",
        "text": "（从车里观看外景）",
        "kana": null,
        "translationZh": "从车里观看外景。",
        "confidence": "high",
        "rawText": "（从车里观看外景）"
      },
      {
        "id": "l11-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l11-app-block-003-line-001",
            "speaker": "李",
            "text": "箱根は ホテルや 旅館が 多いですね。",
            "kana": "はこねは ホテルや りょかんが おおいですね。",
            "translationZh": "箱根的酒店和旅馆很多啊。",
            "confidence": "high",
            "rawText": "李：箱根は ホテルや 旅館が 多いですね。",
            "audioSegment": {
              "id": "l11-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson11/l11-app-block-003-line-001.mp3",
              "start": 0,
              "end": 12.02,
