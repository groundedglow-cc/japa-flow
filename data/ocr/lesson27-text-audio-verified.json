        }
      },
      {
        "id": "l27-basic-s004",
        "order": 4,
        "text": "李さん、明日パーティーに行くでしょう？",
        "translationZh": "小李，明天你会去参加聚会吧？",
        "confidence": "high",
        "rawText": "4. 李さん、明日パーティーに行くでしょう？",
