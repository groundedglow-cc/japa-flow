            }
          }
        ]
      },
      {
        "id": "l27-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l27-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "葉子さんはアルバイトをしながら学校に通っているんですよ。",
            "translationZh": "叶子一边打工一边上学。",
            "confidence": "high",
            "rawText": "甲：葉子さんはアルバイトをしながら学校に通っているんですよ。",
            "audioSegment": {
              "id": "l27-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 4.38,
              "duration": 4.38,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:04:31.717Z",
              "sourceAudioSha256": "3654721a524e44055c4b8f196dd600c256c2c78b046dfac5a21c1df4faf1b09c"
            }
          },
          {
            "id": "l27-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "そうですか。なかなか大変ですね。",
            "translationZh": "是吗？相当不容易啊。",
            "confidence": "high",
            "rawText": "乙：そうですか。なかなか大変ですね。",
            "audioSegment": {
              "id": "l27-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 3.26,
              "duration": 3.26,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:04:31.717Z",
              "sourceAudioSha256": "3654721a524e44055c4b8f196dd600c256c2c78b046dfac5a21c1df4faf1b09c"
            }
          }
        ]
      },
      {
        "id": "l27-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l27-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "森さん、昨日、駅前の喫茶店にいたでしょう？",
            "translationZh": "森先生，昨天你在车站前的咖啡店里吧？",
            "confidence": "high",
            "rawText": "甲：森さん、昨日、駅前の喫茶店にいたでしょう？",
            "audioSegment": {
              "id": "l27-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-dialogue-004-line-001.mp3",
