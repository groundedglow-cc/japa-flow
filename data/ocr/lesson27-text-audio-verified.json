        "lines": [
          {
            "id": "l27-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "学生の時、何を勉強しましたか。",
            "translationZh": "上学时，你学了什么？",
            "confidence": "high",
            "rawText": "甲：学生の時、何を勉強しましたか。",
            "audioSegment": {
              "id": "l27-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 3.1,
              "duration": 3.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:04:31.717Z",
              "sourceAudioSha256": "3654721a524e44055c4b8f196dd600c256c2c78b046dfac5a21c1df4faf1b09c"
            }
          },
          {
            "id": "l27-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "日本の経済について勉強しました。",
            "translationZh": "我学习了有关日本经济的知识。",
            "confidence": "high",
            "rawText": "乙：日本の経済について勉強しました。",
            "audioSegment": {
              "id": "l27-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 2.78,
              "duration": 2.78,
