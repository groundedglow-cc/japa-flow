              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:04:31.717Z",
              "sourceAudioSha256": "3654721a524e44055c4b8f196dd600c256c2c78b046dfac5a21c1df4faf1b09c"
            }
          },
          {
            "id": "l27-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "はい。仕事で、楊さんと会っていたんです。",
            "translationZh": "是的。因为工作，我当时在和小杨见面。",
            "confidence": "high",
            "rawText": "乙：はい。仕事で、楊さんと会っていたんです。",
            "audioSegment": {
              "id": "l27-basic-dialogue-004-line-002",
