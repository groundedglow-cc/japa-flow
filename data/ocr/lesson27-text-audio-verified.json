      {
        "id": "l27-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l27-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "馬さん、暇な時、この書類を整理してください。",
            "translationZh": "小马，有空时请整理一下这些文件。",
            "confidence": "high",
            "rawText": "甲：馬さん、暇な時、この書類を整理してください。",
            "audioSegment": {
              "id": "l27-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.14,
              "duration": 3.14,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:04:31.717Z",
              "sourceAudioSha256": "3654721a524e44055c4b8f196dd600c256c2c78b046dfac5a21c1df4faf1b09c"
            }
          },
          {
            "id": "l27-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "はい、分かりました。",
            "translationZh": "好的，明白了。",
            "confidence": "high",
            "rawText": "乙：はい、分かりました。",
            "audioSegment": {
              "id": "l27-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-dialogue-002-line-002.mp3",
