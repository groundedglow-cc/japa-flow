      {
        "id": "l27-basic-s003",
        "order": 3,
        "text": "李さんはテレビを見ながら食事をしています。",
        "translationZh": "小李边看电视边吃饭。",
        "confidence": "high",
        "rawText": "3. 李さんはテレビを見ながら食事をしています。",
        "audioSegment": {
          "id": "l27-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson27/l27-basic-s003.mp3",
