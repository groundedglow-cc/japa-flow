          "sourceAudioSha256": "3ab5b0991eb412200ee74d131e2fd3dee8dd3a79d46e09fea95242c63c334258"
        }
      },
      {
        "id": "l8-basic-s003",
        "order": 3,
        "text": "わたしは 小野さんに 辞書を もらいました。",
        "kana": "わたしは おのさんに じしょを もらいました。",
        "translationZh": "我从小野女士那里得到了词典。",
        "confidence": "high",
        "rawText": "3. わたしは 小野さんに 辞書を もらいました。",
