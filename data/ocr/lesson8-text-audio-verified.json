              "sourceAudioSha256": "3ab5b0991eb412200ee74d131e2fd3dee8dd3a79d46e09fea95242c63c334258"
            }
          },
          {
            "id": "l8-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "何で 送りましたか。",
            "kana": "なにで おくりましたか。",
            "translationZh": "用什么寄的？",
            "confidence": "high",
            "rawText": "乙：何で 送りましたか。",
            "audioSegment": {
              "id": "l8-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson8/l8-basic-dialogue-001-line-002.mp3",
