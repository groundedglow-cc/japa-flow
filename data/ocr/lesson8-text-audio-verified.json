          "sourceAudioSha256": "3ab5b0991eb412200ee74d131e2fd3dee8dd3a79d46e09fea95242c63c334258"
        }
      },
      {
        "id": "l8-basic-s004",
        "order": 4,
        "text": "李さんは 明日 長島さんに 会います。",
        "kana": "りさんは あした ながしまさんに あいます。",
        "translationZh": "小李明天见长岛先生。",
        "confidence": "high",
        "rawText": "4. 李さんは 明日 長島さんに 会います。",
