    "basicSentences": [
      {
        "id": "l8-basic-s001",
        "order": 1,
        "text": "李さんは 日本語で 手紙を 書きます。",
        "kana": "りさんは にほんごで てがみを かきます。",
        "translationZh": "小李用日语写信。",
        "confidence": "high",
        "rawText": "1. 李さんは 日本語で 手紙を 書きます。",
        "audioSegment": {
          "id": "l8-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson8/l8-basic-s001.mp3",
          "start": 0,
          "end": 3.18,
          "duration": 3.18,
          "method": "approved-asr-alignment",
