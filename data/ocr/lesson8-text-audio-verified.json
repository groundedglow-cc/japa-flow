              "sourceAudioSha256": "3ab5b0991eb412200ee74d131e2fd3dee8dd3a79d46e09fea95242c63c334258"
            }
          },
          {
            "id": "l8-basic-dialogue-001-line-003",
            "speaker": "甲",
            "text": "航空便で 送りました。",
            "kana": "こうくうびんで おくりました。",
            "translationZh": "用航空邮件寄的。",
            "confidence": "high",
            "rawText": "甲：航空便で 送りました。",
