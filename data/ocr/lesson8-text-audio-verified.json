        }
      },
      {
        "id": "l8-basic-s002",
        "order": 2,
        "text": "わたしは 小野さんに お土産を あげます。",
        "kana": "わたしは おのさんに おみやげを あげます。",
        "translationZh": "我送给小野女士礼物。",
        "confidence": "high",
        "rawText": "2. わたしは 小野さんに お土産を あげます。",
        "audioSegment": {
          "id": "l8-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson8/l8-basic-s002.mp3",
