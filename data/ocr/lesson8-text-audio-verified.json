            "translationZh": "刚才长岛先生来电话了。",
            "confidence": "high",
            "rawText": "小野：さっき 長島さんに 電話を もらいました。",
            "audioSegment": {
              "id": "l8-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson8/l8-app-block-003-line-001.mp3",
