  "applicationText": {
    "title": "スケジュール表",
    "blocks": [
      {
        "id": "l8-app-block-001",
        "type": "narration",
        "text": "小李11月初计划和摄影师长岛及小野一起去箱根采访，但小李给长岛发过去的日程表长岛好像没有收到。于是，他打来电话。",
        "kana": null,
        "translationZh": "小李11月初计划和摄影师长岛及小野一起去箱根采访，但小李给长岛发过去的日程表长岛好像没有收到。于是，他打来电话。",
        "confidence": "high",
        "rawText": "小李11月初计划和摄影师长岛及小野一起去箱根采访，但小李给长岛发过去的日程表长岛好像没有收到。于是，他打来电话。"
      },
      {
        "id": "l8-app-block-002",
        "type": "scene",
        "text": "（小野告诉小李，长岛来电话了）",
        "kana": null,
        "translationZh": "小野告诉小李，长岛来电话了。",
        "confidence": "high",
        "rawText": "（小野告诉小李，长岛来电话了）"
