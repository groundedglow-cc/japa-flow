            "rawText": "甲：昨日、母に 誕生日の プレゼントを 送りました。",
            "audioSegment": {
              "id": "l8-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson8/l8-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 3.5,
              "duration": 3.5,
