    "dialogues": [
      {
        "id": "l35-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l35-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "大学を卒業したらどうしますか。",
            "translationZh": "大学毕业后你打算做什么？",
            "confidence": "high",
            "rawText": "甲：大学を卒業したらどうしますか。",
            "audioSegment": {
              "id": "l35-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.58,
              "duration": 2.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:16:04.790Z",
              "sourceAudioSha256": "f83ce440fb00967bf61b1d8ef4dff56ca300c8c9f079e500afaba22ce912ece9"
            }
          },
          {
            "id": "l35-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "外国で働きたいです。",
            "translationZh": "我想在国外工作。",
            "confidence": "high",
            "rawText": "乙：外国で働きたいです。",
            "audioSegment": {
              "id": "l35-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 1.98,
              "duration": 1.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:16:04.790Z",
              "sourceAudioSha256": "f83ce440fb00967bf61b1d8ef4dff56ca300c8c9f079e500afaba22ce912ece9"
            }
          }
        ]
      },
      {
        "id": "l35-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l35-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "馬さんは元気がないね。何かあったのかな。",
            "translationZh": "马先生没什么精神啊。是不是发生什么事了？",
            "confidence": "high",
            "rawText": "甲：馬さんは元気がないね。何かあったのかな。",
            "audioSegment": {
              "id": "l35-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.86,
              "duration": 3.86,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:16:04.790Z",
              "sourceAudioSha256": "f83ce440fb00967bf61b1d8ef4dff56ca300c8c9f079e500afaba22ce912ece9"
            }
          },
          {
            "id": "l35-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "いくら聞いても何も言わないんだよ。",
            "translationZh": "怎么问他他也什么都不说。",
            "confidence": "high",
            "rawText": "乙：いくら聞いても何も言わないんだよ。",
            "audioSegment": {
              "id": "l35-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 2.58,
              "duration": 2.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:16:04.790Z",
              "sourceAudioSha256": "f83ce440fb00967bf61b1d8ef4dff56ca300c8c9f079e500afaba22ce912ece9"
            }
          }
        ]
      },
      {
        "id": "l35-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l35-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "李さん、資料はまだできませんか。",
            "translationZh": "小李，资料还没做好吗？",
            "confidence": "high",
            "rawText": "甲：李さん、資料はまだできませんか。",
            "audioSegment": {
              "id": "l35-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 3.78,
              "duration": 3.78,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:16:04.790Z",
              "sourceAudioSha256": "f83ce440fb00967bf61b1d8ef4dff56ca300c8c9f079e500afaba22ce912ece9"
            }
          },
          {
            "id": "l35-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "すみません、あと少しだけ待ってください。",
            "translationZh": "对不起，请再稍等一会儿。",
            "confidence": "high",
            "rawText": "乙：すみません、あと少しだけ待ってください。",
            "audioSegment": {
              "id": "l35-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 3.3,
              "duration": 3.3,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:16:04.790Z",
              "sourceAudioSha256": "f83ce440fb00967bf61b1d8ef4dff56ca300c8c9f079e500afaba22ce912ece9"
            }
          }
        ]
      },
      {
        "id": "l35-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l35-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "このゴーカートは大人でも乗ることができますか。",
            "translationZh": "这辆卡丁车大人也能坐吗？",
            "confidence": "high",
            "rawText": "甲：このゴーカートは大人でも乗ることができますか。",
            "audioSegment": {
              "id": "l35-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 3.46,
              "duration": 3.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:16:04.790Z",
              "sourceAudioSha256": "f83ce440fb00967bf61b1d8ef4dff56ca300c8c9f079e500afaba22ce912ece9"
            }
          },
          {
            "id": "l35-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "いいえ、子供しか乗ることができません。",
            "translationZh": "不，只有孩子能坐。",
            "confidence": "high",
            "rawText": "乙：いいえ、子供しか乗ることができません。",
            "audioSegment": {
              "id": "l35-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson35/l35-basic-dialogue-004-line-002.mp3",
