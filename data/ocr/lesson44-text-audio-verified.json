              "sourceAudioSha256": "b8d376e851e711dd3262e5d6974eaa1d219d62a21c7b78a915efb0bf2e3d635b"
            }
          },
          {
            "id": "l44-app-block-003-line-007",
            "speaker": "戴",
            "text": "よかったですね。",
            "kana": null,
            "translationZh": "那太好了。",
            "confidence": "high",
            "rawText": "戴：よかったですね。",
            "audioSegment": {
              "id": "l44-app-block-003-line-007",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson44/l44-app-block-003-line-007.mp3",
