      {
        "id": "l44-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l44-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "毎日暑いですね。この暑さはいつまで続くんでしょう。",
            "translationZh": "每天都这么热啊。这股热天要持续到什么时候呢？",
            "confidence": "high",
            "rawText": "甲：毎日暑いですね。この暑さはいつまで続くんでしょう。",
            "audioSegment": {
              "id": "l44-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson44/l44-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 4.93,
              "duration": 4.93,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:29:40.950Z",
              "sourceAudioSha256": "62b907006d05937a5eae3898d932bfaf820ffe58921e63b5f421e456af4f3fc6"
            }
          },
          {
            "id": "l44-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "天気予報によると、まだまだ続くみたいですよ。",
            "translationZh": "据天气预报说，好像还要持续很久。",
            "confidence": "high",
            "rawText": "乙：天気予報によると、まだまだ続くみたいですよ。",
            "audioSegment": {
              "id": "l44-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson44/l44-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 3.82,
