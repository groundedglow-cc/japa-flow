            }
          }
        ]
      },
      {
        "id": "l44-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l44-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "新しい遊園地は、とても人気があるみたいですね。",
            "translationZh": "新的游乐园好像非常受欢迎呢。",
            "confidence": "high",
            "rawText": "甲：新しい遊園地は、とても人気があるみたいですね。",
            "audioSegment": {
              "id": "l44-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson44/l44-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 3.22,
              "duration": 3.22,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:29:40.950Z",
              "sourceAudioSha256": "62b907006d05937a5eae3898d932bfaf820ffe58921e63b5f421e456af4f3fc6"
            }
          },
          {
            "id": "l44-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "ええ。馬さんたちも来週行くらしいですよ。",
            "translationZh": "嗯。马先生他们下周也好像要去。",
            "confidence": "high",
            "rawText": "乙：ええ。馬さんたちも来週行くらしいですよ。",
            "audioSegment": {
              "id": "l44-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson44/l44-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 3.02,
              "duration": 3.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:29:40.950Z",
              "sourceAudioSha256": "62b907006d05937a5eae3898d932bfaf820ffe58921e63b5f421e456af4f3fc6"
            }
          }
        ]
      },
      {
        "id": "l44-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l44-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "ゆうべ行ったビアガーデンはなかなかよかったですね。",
            "translationZh": "昨天晚上去的啤酒花园真不错呢。",
            "confidence": "high",
            "rawText": "甲：ゆうべ行ったビアガーデンはなかなかよかったですね。",
            "audioSegment": {
              "id": "l44-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
