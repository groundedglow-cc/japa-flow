        "lines": [
          {
            "id": "l44-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "葉子さんは留学試験に合格したようですよ。",
            "translationZh": "叶子小姐好像通过了留学考试。",
            "confidence": "high",
            "rawText": "甲：葉子さんは留学試験に合格したようですよ。",
            "audioSegment": {
              "id": "l44-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson44/l44-basic-dialogue-001-line-001.mp3",
