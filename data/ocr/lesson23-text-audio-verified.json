      {
        "id": "l23-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l23-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "北京まで、飛行機の チケットは いくらぐらいですか。",
            "translationZh": "到北京的飞机票大概多少钱？",
            "confidence": "high",
            "rawText": "甲：北京まで、飛行機の チケットは いくらぐらいですか。",
            "audioSegment": {
              "id": "l23-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson23/l23-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.34,
              "duration": 3.34,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:48:09.654Z",
              "sourceAudioSha256": "ff0f91f23d88d62f4ac6dbd2301e18327a6a38b74136c0364f07837f94582c8a"
            }
          },
          {
            "id": "l23-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "季節に よって 高かったり 安かったりです。",
            "translationZh": "根据季节不同，有时贵有时便宜。",
            "confidence": "high",
            "rawText": "乙：季節に よって 高かったり 安かったりです。",
            "audioSegment": {
              "id": "l23-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson23/l23-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 3.46,
              "duration": 3.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T08:48:09.654Z",
              "sourceAudioSha256": "ff0f91f23d88d62f4ac6dbd2301e18327a6a38b74136c0364f07837f94582c8a"
            }
          }
        ]
      },
      {
