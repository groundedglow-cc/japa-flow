        }
      },
      {
        "id": "l23-basic-s002",
        "order": 2,
        "text": "日本語の 先生は 中国人だったり 日本人だったりです。",
        "translationZh": "日语老师有的是中国人，有的是日本人。",
        "confidence": "high",
        "rawText": "2. 日本語の 先生は 中国人だったり 日本人だったりです。",
        "audioSegment": {
          "id": "l23-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson23/l23-basic-s002.mp3",
          "start": 0,
          "end": 4.42,
          "duration": 4.42,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:48:09.654Z",
          "sourceAudioSha256": "ff0f91f23d88d62f4ac6dbd2301e18327a6a38b74136c0364f07837f94582c8a"
        }
      },
      {
        "id": "l23-basic-s003",
        "order": 3,
        "text": "わたしは 今年の 夏、北京へ 行くか どうか 分かりません。",
        "translationZh": "我今年夏天去不去北京还不知道。",
        "confidence": "high",
        "rawText": "3. わたしは 今年の 夏、北京へ 行くか どうか 分かりません。",
        "audioSegment": {
          "id": "l23-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson23/l23-basic-s003.mp3",
          "start": 0,
          "end": 5.06,
          "duration": 5.06,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:48:09.654Z",
          "sourceAudioSha256": "ff0f91f23d88d62f4ac6dbd2301e18327a6a38b74136c0364f07837f94582c8a"
        }
      },
      {
        "id": "l23-basic-s004",
        "order": 4,
        "text": "かぎが どこに あるか 教えて ください。",
        "translationZh": "请告诉我钥匙在哪里。",
        "confidence": "high",
        "rawText": "4. かぎが どこに あるか 教えて ください。",
        "audioSegment": {
