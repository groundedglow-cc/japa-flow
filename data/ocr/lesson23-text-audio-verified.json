        "label": "C",
        "lines": [
          {
            "id": "l23-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "李さん、仕事は 忙しいですか。",
            "translationZh": "小李，工作忙吗？",
            "confidence": "high",
            "rawText": "甲：李さん、仕事は 忙しいですか。",
            "audioSegment": {
              "id": "l23-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson23/l23-basic-dialogue-003-line-001.mp3",
