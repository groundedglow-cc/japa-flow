              "sourceAudioSha256": "66aa43f7567d4afa1f437ea1d68ede04bf3e08f090ccaf32136d093a9d2c12ae"
            }
          },
          {
            "id": "l23-app-block-002-line-003",
            "speaker": "森",
            "text": "いいですね。でも、高く ないですか。",
            "translationZh": "不错。不过不贵吗？",
            "confidence": "high",
            "rawText": "森：いいですね。でも、高く ないですか。",
            "audioSegment": {
              "id": "l23-app-block-002-line-003",
              "trackId": "lesson_apps",
