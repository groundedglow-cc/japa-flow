        "id": "l23-app-block-002",
        "type": "dialogue",
        "lines": [
          {
            "id": "l23-app-block-002-line-001",
            "speaker": "森",
            "text": "小野さん、何を 買うか 決まりましたか。",
            "translationZh": "小野，决定买什么了吗？",
