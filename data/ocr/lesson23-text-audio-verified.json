  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l23-basic-s001",
        "order": 1,
        "text": "小野さんは 休みの 日、散歩したり 買い物に 行ったり します。",
        "translationZh": "小野休息日有时散步，有时去买东西。",
        "confidence": "high",
        "rawText": "1. 小野さんは 休みの 日、散歩したり 買い物に 行ったり します。",
        "audioSegment": {
          "id": "l23-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson23/l23-basic-s001.mp3",
          "start": 0,
          "end": 4.86,
          "duration": 4.86,
