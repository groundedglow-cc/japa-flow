  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l6-basic-s001",
        "order": 1,
        "text": "吉田さんは 来月 中国へ 行きます。",
        "kana": "よしださんは らいげつ ちゅうごくへ いきます。",
        "translationZh": "吉田先生下个月去中国。",
        "confidence": "high",
        "rawText": "1. 吉田さんは 来月 中国へ 行きます。",
        "audioSegment": {
          "id": "l6-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson6/l6-basic-s001.mp3",
          "start": 0,
          "end": 3.5,
          "duration": 3.5,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:27:36.086Z",
          "sourceAudioSha256": "29ef73de64fdcf6a0a354785b6d72bd06fe2b567226a23e46ac6861fee45da16"
        }
      },
      {
        "id": "l6-basic-s002",
        "order": 2,
        "text": "李さんは 先月 北京から 来ました。",
        "kana": "りさんは せんげつ ペキンから きました。",
        "translationZh": "小李上个月从北京来。",
        "confidence": "high",
        "rawText": "2. 李さんは 先月 北京から 来ました。",
        "audioSegment": {
          "id": "l6-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson6/l6-basic-s002.mp3",
          "start": 0,
          "end": 3.18,
          "duration": 3.18,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:27:36.086Z",
          "sourceAudioSha256": "29ef73de64fdcf6a0a354785b6d72bd06fe2b567226a23e46ac6861fee45da16"
        }
      },
      {
        "id": "l6-basic-s003",
        "order": 3,
        "text": "小野さんは 友達と 帰りました。",
        "kana": "おのさんは ともだちと かえりました。",
        "translationZh": "小野女士和朋友一起回去了。",
        "confidence": "high",
        "rawText": "3. 小野さんは 友達と 帰りました。",
        "audioSegment": {
          "id": "l6-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson6/l6-basic-s003.mp3",
          "start": 0,
          "end": 2.98,
          "duration": 2.98,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T08:27:36.086Z",
          "sourceAudioSha256": "29ef73de64fdcf6a0a354785b6d72bd06fe2b567226a23e46ac6861fee45da16"
        }
      },
      {
        "id": "l6-basic-s004",
        "order": 4,
        "text": "森さんは 東京から 広島まで 新幹線で 行きます。",
        "kana": "もりさんは とうきょうから ひろしままで しんかんせんで いきます。",
        "translationZh": "森先生从东京到广岛坐新干线去。",
        "confidence": "high",
        "rawText": "4. 森さんは 東京から 広島まで 新幹線で 行きます。",
        "audioSegment": {
          "id": "l6-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson6/l6-basic-s004.mp3",
