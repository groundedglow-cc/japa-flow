        }
      },
      {
        "id": "l48-basic-s003",
        "order": 3,
        "text": "コピーは私がいたします。",
        "translationZh": "复印件我来做。",
        "confidence": "high",
        "rawText": "3. コピーは私がいたします。",
        "audioSegment": {
          "id": "l48-basic-s003",
          "trackId": "lesson_basic",
