        }
      },
      {
        "id": "l48-basic-s004",
        "order": 4,
        "text": "黄教授に論文を見ていただきました。",
        "translationZh": "黄教授帮我看了论文。",
        "confidence": "high",
        "rawText": "4. 黄教授に論文を見ていただきました。",
        "audioSegment": {
