  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l48-basic-s001",
        "order": 1,
        "text": "お荷物は私がお持ちします。",
        "translationZh": "行李我来拿。",
        "confidence": "high",
        "rawText": "1. お荷物は私がお持ちします。",
        "audioSegment": {
