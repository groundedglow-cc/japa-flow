              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          },
          {
            "id": "l48-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "承知いたしました。少々お待ちください。",
            "translationZh": "知道了。请稍等。",
            "confidence": "high",
            "rawText": "乙：承知いたしました。少々お待ちください。",
            "audioSegment": {
              "id": "l48-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-004-line-002.mp3",
