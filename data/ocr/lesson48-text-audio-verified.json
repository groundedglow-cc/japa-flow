        }
      },
      {
        "id": "l48-basic-s002",
        "order": 2,
        "text": "明日、私がそちらへ伺います。",
        "translationZh": "明天我去您那里拜访。",
        "confidence": "high",
        "rawText": "2. 明日、私がそちらへ伺います。",
        "audioSegment": {
          "id": "l48-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-s002.mp3",
