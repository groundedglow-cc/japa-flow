    "dialogues": [
      {
        "id": "l48-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l48-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "昨日、メールをお送りしたんですが…。",
            "translationZh": "昨天我给您发了邮件……",
            "confidence": "high",
            "rawText": "甲：昨日、メールをお送りしたんですが…。",
            "audioSegment": {
              "id": "l48-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.78,
              "duration": 2.78,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          },
          {
            "id": "l48-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "ええ、拝見しました。先ほど返事をお出ししました。",
            "translationZh": "嗯，我看过了。刚才已经回信了。",
            "confidence": "high",
            "rawText": "乙：ええ、拝見しました。先ほど返事をお出ししました。",
            "audioSegment": {
              "id": "l48-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 4.62,
              "duration": 4.62,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          }
        ]
      },
      {
        "id": "l48-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l48-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "どちらからいらっしゃったんですか。",
            "translationZh": "您是从哪里来的？",
            "confidence": "high",
            "rawText": "甲：どちらからいらっしゃったんですか。",
            "audioSegment": {
              "id": "l48-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 1.9,
              "duration": 1.9,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          },
          {
            "id": "l48-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "中国の北京から参りました。",
            "translationZh": "我从中国北京来。",
            "confidence": "high",
            "rawText": "乙：中国の北京から参りました。",
            "audioSegment": {
              "id": "l48-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 2.34,
              "duration": 2.34,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          }
        ]
      },
      {
        "id": "l48-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l48-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "そろそろ失礼いたします。",
            "translationZh": "我差不多该告辞了。",
            "confidence": "high",
            "rawText": "甲：そろそろ失礼いたします。",
            "audioSegment": {
              "id": "l48-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 1.78,
              "duration": 1.78,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          },
          {
            "id": "l48-basic-dialogue-003-line-002",
            "speaker": "甲",
            "text": "どうもお邪魔いたしました。",
            "translationZh": "打扰了。",
            "confidence": "high",
            "rawText": "どうもお邪魔いたしました。",
            "audioSegment": {
              "id": "l48-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 1.58,
              "duration": 1.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          },
          {
            "id": "l48-basic-dialogue-003-line-003",
            "speaker": "乙",
            "text": "何のお構いもしませんで。",
            "translationZh": "招待不周。",
            "confidence": "high",
            "rawText": "乙：何のお構いもしませんで。",
            "audioSegment": {
              "id": "l48-basic-dialogue-003-line-003",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-003-line-003.mp3",
              "start": 0,
              "end": 1.74,
              "duration": 1.74,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:35:51.152Z",
              "sourceAudioSha256": "13237107ec5d11222155ee55f29660f8556b798116a93bcabd82a8600f9bc9b7"
            }
          }
        ]
      },
      {
        "id": "l48-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l48-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "この服、ちょっと小さいので、取り替えていただけますか。",
            "translationZh": "这件衣服有点小，能给我换一下吗？",
            "confidence": "high",
            "rawText": "甲：この服、ちょっと小さいので、取り替えていただけますか。",
            "audioSegment": {
              "id": "l48-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson48/l48-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 4.3,
