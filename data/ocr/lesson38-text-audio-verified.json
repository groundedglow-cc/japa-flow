    "dialogues": [
      {
        "id": "l38-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l38-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "戴さんはお寿司が食べられますか。",
            "translationZh": "戴先生能吃寿司吗？",
            "confidence": "high",
            "rawText": "甲：戴さんはお寿司が食べられますか。",
            "audioSegment": {
              "id": "l38-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.5,
              "duration": 2.5,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:20:37.854Z",
              "sourceAudioSha256": "d6f87db20608179ff72f01973eb3b785fa385139b9f1e6929f4b646e893d832e"
            }
          },
          {
            "id": "l38-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "ええ、大丈夫ですよ。わたしは何でも食べられます。",
            "translationZh": "嗯，没问题。我什么都能吃。",
            "confidence": "high",
            "rawText": "乙：ええ、大丈夫ですよ。わたしは何でも食べられます。",
            "audioSegment": {
              "id": "l38-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 3.02,
              "duration": 3.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:20:37.854Z",
              "sourceAudioSha256": "d6f87db20608179ff72f01973eb3b785fa385139b9f1e6929f4b646e893d832e"
            }
          }
        ]
      },
      {
        "id": "l38-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l38-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "李さん、２時ごろ会社を出ますよ。",
            "translationZh": "小李，大约两点钟要离开公司。",
            "confidence": "high",
            "rawText": "甲：李さん、２時ごろ会社を出ますよ。",
            "audioSegment": {
              "id": "l38-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 4.42,
              "duration": 4.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:20:37.854Z",
              "sourceAudioSha256": "d6f87db20608179ff72f01973eb3b785fa385139b9f1e6929f4b646e893d832e"
            }
          },
          {
            "id": "l38-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "はい。いつでも出られるように、準備してあります。",
            "translationZh": "好的。已经准备好了，随时都可以出发。",
            "confidence": "high",
            "rawText": "乙：はい。いつでも出られるように、準備してあります。",
            "audioSegment": {
              "id": "l38-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 3.46,
              "duration": 3.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:20:37.854Z",
              "sourceAudioSha256": "d6f87db20608179ff72f01973eb3b785fa385139b9f1e6929f4b646e893d832e"
            }
          }
        ]
      },
      {
        "id": "l38-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l38-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "小野さん、着物を自分で着ることができますか。",
            "translationZh": "小野女士，你能自己穿和服吗？",
            "confidence": "high",
            "rawText": "甲：小野さん、着物を自分で着ることができますか。",
            "audioSegment": {
              "id": "l38-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 3.58,
              "duration": 3.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:20:37.854Z",
              "sourceAudioSha256": "d6f87db20608179ff72f01973eb3b785fa385139b9f1e6929f4b646e893d832e"
            }
          },
          {
            "id": "l38-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "ええ、母に習って、着られるようになりました。",
            "translationZh": "嗯，跟母亲学了以后，已经会穿了。",
            "confidence": "high",
            "rawText": "乙：ええ、母に習って、着られるようになりました。",
            "audioSegment": {
              "id": "l38-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 3.42,
              "duration": 3.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:20:37.854Z",
              "sourceAudioSha256": "d6f87db20608179ff72f01973eb3b785fa385139b9f1e6929f4b646e893d832e"
            }
          }
        ]
      },
      {
        "id": "l38-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l38-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "健康のために何かしていますか。",
            "translationZh": "为了健康，你做些什么吗？",
            "confidence": "high",
            "rawText": "甲：健康のために何かしていますか。",
            "audioSegment": {
              "id": "l38-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 2.46,
              "duration": 2.46,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:20:37.854Z",
              "sourceAudioSha256": "d6f87db20608179ff72f01973eb3b785fa385139b9f1e6929f4b646e893d832e"
            }
          },
          {
            "id": "l38-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "ええ、毎朝１時間散歩するようにしています。",
            "translationZh": "嗯，我坚持每天早晨散步一小时。",
            "confidence": "high",
            "rawText": "乙：ええ、毎朝１時間散歩するようにしています。",
            "audioSegment": {
              "id": "l38-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-basic-dialogue-004-line-002.mp3",
