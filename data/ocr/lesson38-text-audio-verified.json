            }
          }
        ]
      },
      {
        "id": "l38-app-block-007",
        "type": "scene",
        "text": "买了油条递给小野",
        "translationZh": "买了油条递给小野。",
        "confidence": "high",
        "rawText": "（买了油条递给小野）"
      },
      {
        "id": "l38-app-block-008",
        "type": "dialogue",
        "lines": [
          {
            "id": "l38-app-block-008-line-001",
            "speaker": "李",
            "text": "熱いですから、火傷しないように気をつけてくださいね。",
            "translationZh": "很烫，请注意别烫着。",
            "confidence": "high",
            "rawText": "李：熱いですから、火傷しないように気をつけてくださいね。",
            "audioSegment": {
              "id": "l38-app-block-008-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson38/l38-app-block-008-line-001.mp3",
