  "basicText": {
    "title": "基本课文",
    "basicSentences": [
      {
        "id": "l46-basic-s001",
        "order": 1,
        "text": "これは柔らかくて、まるで本物の毛皮のようです。",
        "translationZh": "这摸起来很柔软，简直像真的毛皮一样。",
        "confidence": "high",
        "rawText": "1. これは柔らかくて、まるで本物の毛皮のようです。",
        "audioSegment": {
          "id": "l46-basic-s001",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-s001.mp3",
          "start": 0,
          "end": 5.02,
          "duration": 5.02,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:32:53.718Z",
          "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
        }
      },
      {
        "id": "l46-basic-s002",
        "order": 2,
        "text": "この着物はいかにも日本らしい柄ですね。",
        "translationZh": "这件和服的花纹非常有日本风格呢。",
        "confidence": "high",
        "rawText": "2. この着物はいかにも日本らしい柄ですね。",
        "audioSegment": {
          "id": "l46-basic-s002",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-s002.mp3",
          "start": 0,
          "end": 3.82,
          "duration": 3.82,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:32:53.718Z",
          "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
        }
      },
      {
        "id": "l46-basic-s003",
        "order": 3,
        "text": "明日の9時までにこの書類を完成させなければなりません。",
        "translationZh": "必须在明天9点之前把这份文件完成。",
        "confidence": "high",
        "rawText": "3. 明日の9時までにこの書類を完成させなければなりません。",
        "audioSegment": {
          "id": "l46-basic-s003",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-s003.mp3",
          "start": 0,
          "end": 4.3,
          "duration": 4.3,
          "method": "approved-asr-alignment",
          "confidence": "approved",
          "reviewedAt": "2026-08-05T10:32:53.718Z",
          "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
        }
      },
      {
        "id": "l46-basic-s004",
        "order": 4,
        "text": "わたしが留学している間に、家の周りもずいぶん変わりました。",
        "translationZh": "在我留学期间，家附近也发生了很大的变化。",
        "confidence": "high",
        "rawText": "4. わたしが留学している間に、家の周りもずいぶん変わりました。",
        "audioSegment": {
          "id": "l46-basic-s004",
          "trackId": "lesson_basic",
          "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-s004.mp3",
