            }
          }
        ]
      },
      {
        "id": "l46-app-block-006",
        "type": "scene",
        "text": "想了一会儿",
        "translationZh": "想了一会儿",
        "confidence": "high",
        "rawText": "（想了一会儿）"
      },
      {
        "id": "l46-app-block-007",
        "type": "dialogue",
        "lines": [
          {
            "id": "l46-app-block-007-line-001",
            "speaker": "陳",
            "text": "じゃあ、ここにしましょうか。",
            "translationZh": "那么，就定这里吧。",
            "confidence": "high",
            "rawText": "陳：じゃあ、ここにしましょうか。",
