    "dialogues": [
      {
        "id": "l46-basic-dialogue-001",
        "label": "A",
        "lines": [
          {
            "id": "l46-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "この野菜、レモンのような味がしますね。",
            "translationZh": "这道菜有柠檬味呢。",
            "confidence": "high",
            "rawText": "甲：この野菜、レモンのような味がしますね。",
            "audioSegment": {
              "id": "l46-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-001-line-001.mp3",
              "start": 0,
              "end": 2.98,
              "duration": 2.98,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:32:53.718Z",
              "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
            }
          },
          {
            "id": "l46-basic-dialogue-001-line-002",
            "speaker": "乙",
            "text": "ええ、本当に。まるで果物みたいですね。",
            "translationZh": "嗯，真的。简直像水果一样。",
            "confidence": "high",
            "rawText": "乙：ええ、本当に。まるで果物みたいですね。",
            "audioSegment": {
              "id": "l46-basic-dialogue-001-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-001-line-002.mp3",
              "start": 0,
              "end": 2.85,
              "duration": 2.85,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:32:53.718Z",
              "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
            }
          }
        ]
      },
      {
        "id": "l46-basic-dialogue-002",
        "label": "B",
        "lines": [
          {
            "id": "l46-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "うちの子供は将来、宇宙飛行士になりたいんだって。",
            "translationZh": "我家孩子将来想当宇宙飞行员呢。",
            "confidence": "high",
            "rawText": "甲：うちの子供は将来、宇宙飛行士になりたいんだって。",
            "audioSegment": {
              "id": "l46-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.58,
              "duration": 3.58,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:32:53.718Z",
              "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
            }
          },
          {
            "id": "l46-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "いかにも子供らしい夢ね。",
            "translationZh": "真是很孩子气的梦想呢。",
            "confidence": "high",
            "rawText": "乙：いかにも子供らしい夢ね。",
            "audioSegment": {
              "id": "l46-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-002-line-002.mp3",
              "start": 0,
              "end": 2.18,
              "duration": 2.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:32:53.718Z",
              "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
            }
          }
        ]
      },
      {
        "id": "l46-basic-dialogue-003",
        "label": "C",
        "lines": [
          {
            "id": "l46-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "この書類、いつ発送しますか。",
            "translationZh": "这份文件什么时候发送？",
            "confidence": "high",
            "rawText": "甲：この書類、いつ発送しますか。",
            "audioSegment": {
              "id": "l46-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 2.38,
              "duration": 2.38,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:32:53.718Z",
              "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
            }
          },
          {
            "id": "l46-basic-dialogue-003-line-002",
            "speaker": "乙",
            "text": "そうですね。今月の末までに届くように出してください。",
            "translationZh": "嗯。那么，请在本月底之前送出，使它能按时送到。",
            "confidence": "high",
            "rawText": "乙：そうですね。今月の末までに届くように出してください。",
            "audioSegment": {
              "id": "l46-basic-dialogue-003-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-003-line-002.mp3",
              "start": 0,
              "end": 5.02,
              "duration": 5.02,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:32:53.718Z",
              "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
            }
          }
        ]
      },
      {
        "id": "l46-basic-dialogue-004",
        "label": "D",
        "lines": [
          {
            "id": "l46-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "オートバイを買うそうだね。高いだろう。",
            "translationZh": "听说你要买摩托车啊。应该挺贵吧。",
            "confidence": "high",
            "rawText": "甲：オートバイを買うそうだね。高いだろう。",
            "audioSegment": {
              "id": "l46-basic-dialogue-004-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-004-line-001.mp3",
              "start": 0,
              "end": 3.1,
              "duration": 3.1,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:32:53.718Z",
              "sourceAudioSha256": "b730fa08475d2bcb93f811031ff4b340840c6af847838816cf71efcad3529c6d"
            }
          },
          {
            "id": "l46-basic-dialogue-004-line-002",
            "speaker": "乙",
            "text": "うん、学校が休みの間、アルバイトをするつもりなんだ。",
            "translationZh": "嗯，我打算在学校放假期间打工。",
            "confidence": "high",
            "rawText": "乙：うん、学校が休みの間、アルバイトをするつもりなんだ。",
            "audioSegment": {
              "id": "l46-basic-dialogue-004-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson46/l46-basic-dialogue-004-line-002.mp3",
              "start": 0,
              "end": 4.18,
              "duration": 4.18,
              "method": "approved-asr-alignment",
              "confidence": "approved",
