        "lines": [
          {
            "id": "l43-basic-dialogue-001-line-001",
            "speaker": "甲",
            "text": "今、子供を買い物に行かせています。",
            "translationZh": "我现在让孩子去买东西了。",
            "confidence": "high",
            "rawText": "甲：今、子供を買い物に行かせています。",
            "audioSegment": {
              "id": "l43-basic-dialogue-001-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson43/l43-basic-dialogue-001-line-001.mp3",
