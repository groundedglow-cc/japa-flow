        "label": "D",
        "lines": [
          {
            "id": "l43-basic-dialogue-004-line-001",
            "speaker": "甲",
            "text": "この駅は乗り換えが分かりにくいですね。",
            "translationZh": "这个车站换乘不太容易懂啊。",
            "confidence": "high",
