        "label": "B",
        "lines": [
          {
            "id": "l43-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "遠いですから、駅まで部下に送らせましょうか。",
            "translationZh": "因为很远，要不要让部下送您到车站？",
            "confidence": "high",
            "rawText": "甲：遠いですから、駅まで部下に送らせましょうか。",
            "audioSegment": {
              "id": "l43-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson43/l43-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 3.5,
              "duration": 3.5,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:28:08.334Z",
              "sourceAudioSha256": "7df826f5415a6d73d1fa3e6ea50bd77ba0a0c1c34a29ff34a7895c9c07aee202"
