        "label": "C",
        "lines": [
          {
            "id": "l43-basic-dialogue-003-line-001",
            "speaker": "甲",
            "text": "部長、気分が悪いので、早く帰らせてください。",
            "translationZh": "部长，我身体不舒服，请让我早点回去。",
            "confidence": "high",
            "rawText": "甲：部長、気分が悪いので、早く帰らせてください。",
            "audioSegment": {
              "id": "l43-basic-dialogue-003-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson43/l43-basic-dialogue-003-line-001.mp3",
              "start": 0,
              "end": 5.1,
