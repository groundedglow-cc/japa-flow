          },
          {
            "id": "l43-basic-dialogue-002-line-002",
            "speaker": "乙",
            "text": "大丈夫です。ありがとうございます。",
            "translationZh": "没关系。谢谢。",
            "confidence": "high",
            "rawText": "乙：大丈夫です。ありがとうございます。",
            "audioSegment": {
              "id": "l43-basic-dialogue-002-line-002",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson43/l43-basic-dialogue-002-line-002.mp3",
