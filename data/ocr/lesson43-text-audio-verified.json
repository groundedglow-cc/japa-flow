  "applicationText": {
    "title": "プレゼンテーション",
    "blocks": [
      {
        "id": "l43-app-block-001",
        "type": "narration",
        "text": "JC策划北京分公司受CS公司委托，承担他们新产品的策划、宣传。森和小李在CS公司就新产品的名称以及设计图案等做了说明。",
        "translationZh": "JC策划北京分公司受CS公司委托，承担他们新产品的策划、宣传。森和小李在CS公司就新产品的名称以及设计图案等做了说明。",
        "confidence": "high",
        "rawText": "JC策划北京分公司受CS公司委托，承担他们新产品的策划、宣传。森和小李在CS公司就新产品的名称以及设计图案等做了说明。"
      },
      {
        "id": "l43-app-block-002",
        "type": "scene",
        "text": "（在北京分公司的办公室。加藤经理告诉老陈派森和小李去CS公司）",
        "translationZh": "（在北京分公司的办公室。加藤经理告诉老陈派森和小李去CS公司）",
        "confidence": "high",
        "rawText": "（在北京分公司的办公室。加藤经理告诉老陈派森和小李去CS公司）"
      },
      {
        "id": "l43-app-block-003",
        "type": "dialogue",
        "lines": [
          {
            "id": "l43-app-block-003-line-001",
            "speaker": "陈",
            "text": "ＣＳ公司的プレゼン，だれに行ってもらいましょうか。",
            "translationZh": "CS公司的展示会，派谁去比较好呢？",
            "confidence": "high",
            "rawText": "陳：ＣＳ公司的プレゼン，だれに行ってもらいましょうか。",
            "audioSegment": {
              "id": "l43-app-block-003-line-001",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson43/l43-app-block-003-line-001.mp3",
              "start": 0,
              "end": 15.05,
              "duration": 15.05,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:29:05.294Z",
              "sourceAudioSha256": "4b2ef0bc37bfdd3843e05e06774f33bbf5c2938e1c1a1fa6ea6a333a7d22aaf8"
            }
          },
          {
            "id": "l43-app-block-003-line-002",
            "speaker": "加藤",
            "text": "森君と李さんを行かせるつもりです。",
            "translationZh": "打算让森和小李去。",
            "confidence": "high",
            "rawText": "加藤：森君と李さんを行かせるつもりです。",
            "audioSegment": {
              "id": "l43-app-block-003-line-002",
              "trackId": "lesson_apps",
              "sourceUrl": "/data/ocr/audio-clips/lesson43/l43-app-block-003-line-002.mp3",
              "start": 0,
              "end": 2.42,
              "duration": 2.42,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:29:05.294Z",
