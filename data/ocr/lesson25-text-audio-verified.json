        "label": "B",
        "lines": [
          {
            "id": "l25-basic-dialogue-002-line-001",
            "speaker": "甲",
            "text": "あの 窓の ところに いる 人は だれですか。",
            "translationZh": "在那扇窗户旁边的人是谁？",
            "confidence": "high",
            "rawText": "甲：あの窓のところにいる人はだれですか。",
            "audioSegment": {
              "id": "l25-basic-dialogue-002-line-001",
              "trackId": "lesson_basic",
              "sourceUrl": "/data/ocr/audio-clips/lesson25/l25-basic-dialogue-002-line-001.mp3",
              "start": 0,
              "end": 2.7,
              "duration": 2.7,
              "method": "approved-asr-alignment",
              "confidence": "approved",
              "reviewedAt": "2026-08-05T10:01:37.913Z",
              "sourceAudioSha256": "6caa1f10af54614b4030a242c0ddce3f3aaf438875c7b06d8de7731673e0c3cd"
            }
