            }
          }
        ]
      },
      {
        "id": "l25-app-block-006",
        "type": "scene",
        "text": "车内响起日语歌曲。",
        "translationZh": "车内响起日语歌曲。",
        "confidence": "high",
        "rawText": "（车内响起日语歌曲）"
      },
      {
        "id": "l25-app-block-007",
        "type": "dialogue",
        "lines": [
          {
            "id": "l25-app-block-007-line-001",
            "speaker": "森",
            "text": "あっ、これ、日本の 歌ですね。",
            "translationZh": "啊，这是日本歌曲吧。",
