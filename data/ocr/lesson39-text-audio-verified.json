              "asrText": "こ の 門 は 昔 家 事 の た め に 二 度 も 焼 け た こ と が あ る ん で す よ",
              "phraseIndexes": [
                2
              ],
              "method": "legacy-asr-alignment-range-converted",
              "confidence": "approved",
              "review": {
